+def _hybrid_ep_tp_swap_local(
+    out_local: FusedMoEWeights,
+    shard_axis: str | tuple[str, ...],
+    ep_size: int,
+) -> FusedMoEWeights:
+    """Transform local MoE weights from pure EP=(ep_size, TP=1) to Hybrid (EP=ep_size//2, TP=2).
+
+    Each adjacent chip pair (2k, 2k+1) exchanges half of the intermediate dimension
+    via a direct point-to-point ICI ppermute so that both chips hold all 2*n_local
+    experts of EP group k, with chip 2k holding TP shard 0 (first half of intermediate_size)
+    and chip 2k+1 holding TP shard 1 (second half of intermediate_size).
+    """
+    perm = [(2 * k, 2 * k + 1) for k in range(ep_size // 2)] + [
+        (2 * k + 1, 2 * k) for k in range(ep_size // 2)
+    ]
+    tp_idx = jax.lax.axis_index(shard_axis) % 2
+
+    def _swap_halves(half0: jax.Array, half1: jax.Array) -> jax.Array:
+        to_send = jnp.where(tp_idx == 0, half1, half0)
+        received = jax.lax.ppermute(to_send, axis_name=shard_axis, perm=perm)
+        first_half = jnp.where(tp_idx == 0, half0, received)
+        second_half = jnp.where(tp_idx == 0, received, half1)
+        return jnp.concatenate([first_half, second_half], axis=0)
+
+    w13 = out_local.w13_weight
+    inter = w13.shape[2] // 2
