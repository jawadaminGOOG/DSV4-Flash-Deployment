+            w2_chunk_val = decode_e2m1(w2_raw[:, macro_start:macro_end],
+                                       compute_dtype)
+        else:
+            w2_chunk_val = w2_raw[:, macro_start:macro_end].astype(
+                compute_dtype)
+        w2_chunk_deq = (
+            w2_chunk_val.reshape(w2_num_blocks, w2_qbs, macro_cols) *
+            w2_scale_all[:, :, macro_start:macro_end]
+        ).reshape(cfgs2.tiles.tile_k, macro_cols)
+        for sub_start in range(0, macro_cols, mxu_size):
+            sub_end = min(macro_cols, sub_start + mxu_size)
+            acc2_strip = jnp.matmul(
+                inter_bf16,
+                w2_chunk_deq[:, sub_start:sub_end],
+                preferred_element_type=jnp.float32,
+            )
+            acc2_list.append(acc2_strip)
+    acc2 = jnp.concatenate(acc2_list, axis=1)
+
+    # 5. Mask output rows and accumulate sublane boundaries via partial_out_ref
+    iota_out = lax.broadcasted_iota(jnp.int32, acc2.shape, 0)
+    mask_out = jnp.logical_and(m_start_local <= iota_out,
+                               iota_out < m_end_local)
+    acc2_masked = jnp.where(mask_out, acc2, 0).astype(tiled_out_ref.dtype)
+
+    tiled_out_2d_ref = tiled_out_ref.reshape(-1, cfgs2.tiles.tile_n)
+    tiled_out_2d_ref[:bucket_m] = acc2_masked
+
+    partial_out_zeros = jnp.zeros_like(partial_out_ref)
+    tiled_out_ref[0] += jnp.where(gm_id == 0, partial_out_zeros,
+                                  partial_out_ref[...])
+
+    last_row = m_end_local // sublane
+    safe_last_row = jnp.minimum(last_row, (bucket_m // sublane) - 1)
+    partial_out_ref[...] = jnp.where(
+        m_end_local % sublane == 0,
+        partial_out_zeros,
+        tiled_out_ref[safe_last_row],
+    )
