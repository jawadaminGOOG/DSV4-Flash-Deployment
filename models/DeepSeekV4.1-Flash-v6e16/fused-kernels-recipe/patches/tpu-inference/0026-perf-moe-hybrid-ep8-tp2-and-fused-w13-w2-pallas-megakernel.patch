+    w13_half1 = jnp.concatenate(
+        [w13[:, :, half_inter:inter], w13[:, :, inter + half_inter:]], axis=2)
+    new_w13 = _swap_halves(w13_half0, w13_half1)
+
+    new_w13_s = None
