             # Mask out rows that does not belong to the current group.
             iota = lax.broadcasted_iota(jnp.int32, acc.shape, 0)
@@ -1057,35 +1037,34 @@ def calculate_tiling(
     tile_k = align_to(dims.size_k, num_lanes)
     tile_n = align_to(size_n_per_rhs, num_lanes)
 
+    mxu_size = pltpu.get_tpu_info().mxu_column_size
+
     def _gmm_vmem_estimate(tm: int, tn: int, tk: int) -> int:
         # 1. LHS tile (double-buffered HBM load)
         lhs_tile_bytes = lhs_bits // 8
         lhs_vmem = 2 * tm * tk * lhs_tile_bytes
-        # If LHS is quantized on-the-fly, we need an extra single-buffered cast
-        # buffer in VMEM.
         if lhs_cfgs.should_quantize:
             lhs_quant_bits = jax.dtypes.itemsize_bits(lhs_cfgs.quant_dtype)
             lhs_vmem += tm * tk * (lhs_quant_bits // 8)
 
-        # 2. RHS tile (triple-buffered, includes scale and bias if present)
-        # If fuse_act is enabled, we have both gate and up weights,
-        # so RHS memory is doubled.
+        # 2. RHS tile (double-buffered when MXFP4 tile_n >= 768, else triple-buffered)
         rhs_weight_vmem = tk * tn * rhs_bits // 8
         rhs_scale_vmem = 0
         if rhs_cfgs.has_scale and rhs_cfgs.quant_block_size is not None:
             num_quant_blocks_per_tile_k = pl.cdiv(tk,
                                                   rhs_cfgs.quant_block_size)
-            rhs_scale_vmem = num_quant_blocks_per_tile_k * tn * 4
+            scale_bytes = 1 if rhs_cfgs.scale_dtype == jnp.uint8 else 4
+            rhs_scale_vmem = num_quant_blocks_per_tile_k * tn * scale_bytes
         rhs_bias_vmem = 0
         if rhs_cfgs.has_bias:
             rhs_bias_vmem = tn * 4
         rhs_vmem = fuse_act_factor * (3 * rhs_weight_vmem +
                                       2 * rhs_scale_vmem + 2 * rhs_bias_vmem)
 
-        # 3. Accumulator
-        acc_cols = fuse_act_factor * tn
+        # 3. Accumulator (double-buffered)
         acc_dtype_bytes = 2 if lhs_cfgs.quant_dtype is not None else 4
-        acc_vmem = tm * acc_cols * acc_dtype_bytes
+        acc_cols = fuse_act_factor * tn
+        acc_vmem = 2 * tm * acc_cols * acc_dtype_bytes
 
         # 4. Output tile (double-buffered)
         out_dtype_bytes = jax.dtypes.itemsize_bits(lhs_cfgs.dtype) // 8
@@ -1093,8 +1072,13 @@ def calculate_tiling(
 
         return lhs_vmem + rhs_vmem + acc_vmem + out_vmem
 
-    # Multiple k tiles will introduce accumulation overhead. Thus, we first try
-    # to fit the tensors into vmem by only adjusting tile_n.
+    # Optional Wave 10 explicit N-tile target for MXFP4 decode/saturation
+    env_num_n_tiles = int(os.environ.get("VLLM_GMM_V2_DECODE_NUM_N_TILES", "0"))
+    if (env_num_n_tiles > 0 and dims.size_m <= 2048 and dims.size_group > 1
+            and rhs_cfgs.encoding == MXFP4_ENCODING):
+        num_n_tiles = env_num_n_tiles
+        tile_n = align_to(size_n_per_rhs,
+                          num_n_tiles * num_lanes) // num_n_tiles
 
     # Decrease tile_n until total memory fits in vmem limit.
     while (_gmm_vmem_estimate(tile_m, tile_n, tile_k) > vmem_limit_bytes
@@ -1103,6 +1087,22 @@ def calculate_tiling(
         tile_n = align_to(size_n_per_rhs,
                           num_n_tiles * num_lanes) // num_n_tiles
 
+    # Prefer zero-padding N-tiles (e.g. 768 or 1152 for 2304, 2560 for 5120)
+    # when MXFP4 strip-wise dequantization is active, avoiding 11.1% wasted
+    # MXU columns from non-dividing tile_n (such as 512 for 2304).
+    if (env_num_n_tiles == 0 and rhs_cfgs.encoding == MXFP4_ENCODING
+            and size_n_per_rhs % tile_n != 0):
+        for cand_nt in range(max(2, num_n_tiles), num_n_tiles + 4):
+            cand_tn = align_to(size_n_per_rhs,
+                               cand_nt * num_lanes) // cand_nt
+            if (cand_tn >= tile_n_limit and size_n_per_rhs % cand_tn == 0
+                    and (fuse_act_factor * cand_tn) % mxu_size == 0
+                    and _gmm_vmem_estimate(tile_m, cand_tn, tile_k)
+                    <= vmem_limit_bytes):
+                num_n_tiles = cand_nt
+                tile_n = cand_tn
+                break
+
     # If decreasing tile_n is no longer possible, we decrease tile_k instead.
     if tile_n < tile_n_limit:
         num_n_tiles -= 1
@@ -1491,11 +1491,14 @@ def gmm_v2(
     # Initialize scratch shapes.
     max_num_gm = dims.size_group + pl.cdiv(dims.size_m, tiles.tile_m) - 1
     acc_cols = 2 * tiles.tile_n if cfgs.fuse_act is not None else tiles.tile_n
+    need_acc_scratch = pl.cdiv(dims.size_k, tiles.tile_k) > 1
+    acc_scratch_shape = ((tiles.tile_m, acc_cols)
+                         if need_acc_scratch else (1, 128))
     scratch_shapes = [
         # partial_out_ref
         pltpu.VMEM((dims.size_lhs_sublane, tiles.tile_n), cfgs.out_dtype),
-        # acc_ref
-        pltpu.VMEM((tiles.tile_m, acc_cols), cfgs.acc_dtype),
+        # acc_ref (only used when num_k_tiles > 1)
+        pltpu.VMEM(acc_scratch_shape, cfgs.acc_dtype),
         # metadata_ref
         MetadataRef(
             gm_id_to_group_id=pltpu.SMEM((max_num_gm, ), jnp.int32),
@@ -1557,3 +1560,364 @@ def gmm_v2(
         cost_estimate=get_cost_estimate(cfgs),
         metadata=get_metadata(cfgs),
     )(group_sizes, group_offset, lhs, rhs_weights)[:, :cfgs.out_size_n]
+
+
+def _fused_w13_w2_inner_kernel(
+    tiled_lhs_ref: jax.Array,
+    tiled_w13_ref: RhsRef,
+    tiled_w2_ref: RhsRef,
+    tiled_out_ref: jax.Array,
+    partial_out_ref: jax.Array,
+    metadata_ref: MetadataRef,
+    *,
+    cfgs1: GmmConfigs,
+    cfgs2: GmmConfigs,
+):
+    """Single-kernel Pallas inner loop fusing w13 + silu_and_mul + w2 in VMEM."""
+    gm_id = pl.program_id(1)
+    m_start = metadata_ref.gm_id_to_m_offset[gm_id]
+    m_end = metadata_ref.gm_id_to_m_offset[gm_id + 1]
+    sublane = cfgs1.dims.size_lhs_sublane
+    m_offset = m_start - m_start % sublane
+    m_start_local = m_start - m_offset
+    m_end_local = m_end - m_offset
+
+    tpu_info = pltpu.get_tpu_info()
+    mxu_size = tpu_info.mxu_column_size
+    bucket_m = cfgs1.tiles.tile_m
+    compute_dtype = cfgs1.lhs_cfgs.dtype
+
+    # 1. Load LHS [tile_m, k1=5120] in VMEM
+    tiled_lhs = tiled_lhs_ref.reshape(-1, cfgs1.tiles.tile_k)[:bucket_m]
+
+    # 2. Compute W13 ([5120, 2304]) in 3 macro-chunks of 768 columns (7.5 MiB bf16 VMEM peak)
+    w13_raw = tiled_w13_ref.get_weight()
+    w13_rhs_n = w13_raw.shape[1]
+    w13_qbs = cfgs1.rhs_cfgs.quant_block_size
+    w13_num_blocks = cfgs1.num_quant_blocks_per_tile_k
+    w13_raw_scale = tiled_w13_ref.get_scale()
+    if cfgs1.rhs_cfgs.scale_dtype == jnp.uint8:
+        w13_scale_all = decode_e8m0(w13_raw_scale, compute_dtype)
+    else:
+        w13_scale_all = w13_raw_scale.astype(compute_dtype)
+    if w13_scale_all.ndim == 2:
+        w13_scale_all = w13_scale_all[:, None, :]
+
+    w13_macro_step = 768
+    acc13_list = []
+    for macro_start in range(0, w13_rhs_n, w13_macro_step):
+        macro_end = min(w13_rhs_n, macro_start + w13_macro_step)
+        macro_cols = macro_end - macro_start
+        if cfgs1.rhs_cfgs.encoding == MXFP4_ENCODING:
+            w13_chunk_val = decode_e2m1(w13_raw[:, macro_start:macro_end],
+                                        compute_dtype)
+        else:
+            w13_chunk_val = w13_raw[:, macro_start:macro_end].astype(
+                compute_dtype)
+        w13_chunk_deq = (
+            w13_chunk_val.reshape(w13_num_blocks, w13_qbs, macro_cols) *
+            w13_scale_all[:, :, macro_start:macro_end]
+        ).reshape(cfgs1.tiles.tile_k, macro_cols)
+        for sub_start in range(0, macro_cols, mxu_size):
+            sub_end = min(macro_cols, sub_start + mxu_size)
+            acc_strip = jnp.matmul(
+                tiled_lhs,
+                w13_chunk_deq[:, sub_start:sub_end],
+                preferred_element_type=jnp.float32,
+            )
+            acc13_list.append(acc_strip)
+    acc13 = jnp.concatenate(acc13_list, axis=1)
+
+    # 3. Apply SiLU-and-mul activation in VMEM registers & mask invalid rows before W2
+    inter = apply_act_fn(acc13, cfgs1.fuse_act)
+    iota_inter = lax.broadcasted_iota(jnp.int32, inter.shape, 0)
+    mask_inter = jnp.logical_and(m_start_local <= iota_inter,
+                                 iota_inter < m_end_local)
+    inter_bf16 = jnp.where(mask_inter, inter, 0).astype(compute_dtype)
+
+    # 4. Compute W2 ([1152, 5120]) in 2 macro-chunks of 2560 columns (5.625 MiB bf16 VMEM peak)
+    w2_raw = tiled_w2_ref.get_weight()
+    w2_rhs_n = w2_raw.shape[1]
+    w2_qbs = cfgs2.rhs_cfgs.quant_block_size
+    w2_num_blocks = cfgs2.num_quant_blocks_per_tile_k
+    w2_raw_scale = tiled_w2_ref.get_scale()
+    if cfgs2.rhs_cfgs.scale_dtype == jnp.uint8:
+        w2_scale_all = decode_e8m0(w2_raw_scale, compute_dtype)
+    else:
+        w2_scale_all = w2_raw_scale.astype(compute_dtype)
+    if w2_scale_all.ndim == 2:
+        w2_scale_all = w2_scale_all[:, None, :]
+
+    w2_macro_step = 2560
+    acc2_list = []
+    for macro_start in range(0, w2_rhs_n, w2_macro_step):
+        macro_end = min(w2_rhs_n, macro_start + w2_macro_step)
+        macro_cols = macro_end - macro_start
