                                                      col_size]
-                        block_acc *= rhs_scale_replicated.astype(acc_ref.dtype)
+                        block_acc *= rhs_scale_replicated.astype(cfgs.acc_dtype)
 
                     acc_n += block_acc
+                if fuse_strip_post:
