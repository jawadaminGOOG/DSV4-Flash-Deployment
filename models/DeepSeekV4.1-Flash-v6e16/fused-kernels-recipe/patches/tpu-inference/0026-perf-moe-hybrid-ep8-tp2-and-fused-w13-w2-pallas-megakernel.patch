@@ -567,43 +559,27 @@ def inner_kernel(
                 dtype_max = float(jnp.iinfo(lhs_q_dtype).max)
                 preferred_element_type = jnp.int32
 
-            # Without n outer loop, result of quantized matmul becomes available only
