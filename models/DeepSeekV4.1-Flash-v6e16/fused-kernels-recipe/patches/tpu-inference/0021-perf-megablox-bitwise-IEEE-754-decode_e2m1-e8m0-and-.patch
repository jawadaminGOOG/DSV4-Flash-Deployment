From f7fac00fe4a7d7c5a2b92bc97361c67474b6dc9e Mon Sep 17 00:00:00 2001
From: Jawad Amin <jawadamin@google.com>
Date: Thu, 24 Sep 2026 01:17:29 +0000
Subject: [PATCH 21/25] perf(megablox): bitwise IEEE-754 decode_e2m1/e8m0 and configurable decode m_tiling
 decode_e2m1/e8m0, fix bucket_idx off-by-one, decode-aware tile_m/bucket_base
 in gmm_v2

---
 tpu_inference/kernels/megablox/gmm_v2.py | 50 +++++++++++++++++-------
 1 file changed, 36 insertions(+), 14 deletions(-)

diff --git a/tpu_inference/kernels/megablox/gmm_v2.py b/tpu_inference/kernels/megablox/gmm_v2.py
index 12dc476e..ff3884d9 100644
--- a/tpu_inference/kernels/megablox/gmm_v2.py
+++ b/tpu_inference/kernels/megablox/gmm_v2.py
@@ -17,6 +17,7 @@
 
 import dataclasses
 import functools
+import os
 from abc import ABC, abstractmethod
 from typing import Any, Callable, Tuple
 
@@ -131,18 +132,19 @@ _E8M0_EXPONENT_BIAS = 127
 def decode_e2m1(code: jax.Array, dtype: jnp.dtype) -> jax.Array:
     """Return the E2M1 value of a four-bit code held in `int4`.
 
-    The code carries the FP4 bit pattern, so the sign bit of the `int4` is the
-    sign of the value, and the low three bits select one of eight magnitudes.
-    Two's complement makes the sign test a comparison against zero.
+    Constructs the exact IEEE-754 float32 bit pattern directly using bitwise
+    shifts and a single select (`index <= 1`), avoiding sequential int->float
+    casts and three branch selects per weight element.
     """
     wide = code.astype(jnp.int32)
     index = jax.lax.bitwise_and(wide, 7)
-    # The first five magnitudes are half the index. The last three are not.
-    magnitude = 0.5 * index.astype(jnp.float32)
-    magnitude = jnp.where(index == 5, 3.0, magnitude)
-    magnitude = jnp.where(index == 6, 4.0, magnitude)
-    magnitude = jnp.where(index == 7, 6.0, magnitude)
-    return jnp.where(wide < 0, -magnitude, magnitude).astype(dtype)
+    sign_bit = jax.lax.bitwise_and(wide, 8) << 28
+    f32_bits = jnp.where(
+        index <= 1,
+        (-index) & 0x3F000000,
+        0x3F000000 + (index << 22),
+    ) | sign_bit
+    return jax.lax.bitcast_convert_type(f32_bits, jnp.float32).astype(dtype)
 
 
 def infer_rhs_encoding(rhs: jax.Array,
@@ -162,9 +164,9 @@ def infer_rhs_encoding(rhs: jax.Array,
 
 
 def decode_e8m0(scale: jax.Array, dtype: jnp.dtype) -> jax.Array:
-    """Return the value of an E8M0 scale held in `uint8`."""
-    exponent = scale.astype(jnp.float32) - _E8M0_EXPONENT_BIAS
-    return jnp.exp2(exponent).astype(dtype)
+    """Return the value of an E8M0 scale held in `uint8` via IEEE-754 exponent shift."""
+    f32_bits = scale.astype(jnp.int32) << 23
+    return jax.lax.bitcast_convert_type(f32_bits, jnp.float32).astype(dtype)
 
 
 # Define data classes.
@@ -650,10 +652,12 @@ def inner_kernel(
             # since it completely fills the size_lhs_sublane rows, we need to zero out
             # partial_out_ref to avoid numeric error for group 3.
             last_row = m_end_local // cfgs.dims.size_lhs_sublane
+            safe_last_row = jnp.minimum(
+                last_row, (acc_m // cfgs.dims.size_lhs_sublane) - 1)
             partial_out_ref[...] = jnp.where(
                 m_end_local % cfgs.dims.size_lhs_sublane == 0,
                 partial_out_zeros,
-                tiled_out_ref[last_row],
+                tiled_out_ref[safe_last_row],
             )
         else:
             acc_ref[:acc_m] = acc
@@ -705,7 +709,7 @@ def inner_kernel(
     for bucket_idx in range(cfgs.tiles.tile_m // cfgs.tiles.bucket_base):
         branches.append(
             functools.partial(run_matmul_step, bucket_idx=bucket_idx))
-    bucket_idx = m_end_local // cfgs.tiles.bucket_base
+    bucket_idx = (jnp.maximum(m_end_local, 1) - 1) // cfgs.tiles.bucket_base
     lax.switch(bucket_idx, branches)
 
 
@@ -1102,6 +1106,24 @@ def calculate_tiling(
     # Revisit the value to be based on number of instruction memory size.
     max_num_buckets = 4
     bucket_base = tile_m
+    if dims.size_m <= 2048 and dims.size_group > 1:
+        env_bbase = int(os.environ.get("VLLM_GMM_V2_DECODE_BUCKET_BASE", "0"))
+        env_tm = int(os.environ.get("VLLM_GMM_V2_DECODE_TILE_M", "0"))
+        if env_bbase > 0 and env_tm > 0:
+            bucket_base = min(env_bbase, env_tm, dims.size_m)
+            tile_m = min(env_tm, dims.size_m)
+            while (_gmm_vmem_estimate(tile_m, tile_n, tile_k) > vmem_limit_bytes
+                   and tile_m > bucket_base):
+                tile_m -= bucket_base
+            return TileSizes(tile_m=tile_m,
+                             tile_k=tile_k,
+                             tile_n=tile_n,
+                             bucket_base=bucket_base)
+        # Decode regime (avg tokens/group <= 64): use finer 32-row buckets up to 128
+        if tile_m >= 64:
+            bucket_base = 32
+            tile_m = 32
+
     for _ in range(1, max_num_buckets):
         new_tile_m = tile_m + bucket_base
         if new_tile_m > dims.size_m:
