+    # counting the ends at or below the token gives the same index, and a count
+    # is one comparison and one sum rather than a data-dependent loop.
+    token = torch.arange(num_tokens, device=device, dtype=torch.int64)
+    ends = query_start_loc[1 : num_query_rows + 1].to(torch.int64)
+    req = torch.clamp((token[:, None] >= ends[None, :]).sum(-1), max=num_query_rows - 1)
+
+    chunk_idx = torch.clamp(query_start_loc.to(torch.int64)[req], max=num_tokens - 1)
+    chunk_start = positions.to(torch.int64)[chunk_idx]
+    position = positions.to(torch.int64)[:num_tokens]
