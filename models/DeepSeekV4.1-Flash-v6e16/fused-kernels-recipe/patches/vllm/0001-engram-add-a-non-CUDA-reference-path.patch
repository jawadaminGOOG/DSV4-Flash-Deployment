+        # History still inside this chunk: read it straight from `input_ids`.
+        in_batch = lookback >= chunk_start
+        batch_idx = torch.clamp(token - shift, min=0)
+        batch_source = token_map[ids[batch_idx]]
+        batch_source = torch.where(dead[batch_idx], DEAD_ID, batch_source)
+
+        # History just before this chunk: the runner passes it in.
+        column = chunk_start - 1 - lookback
+        in_window = ~in_batch & (column >= 0) & (column < lookback_depth)
+        column = torch.clamp(column, 0, lookback_depth - 1)
