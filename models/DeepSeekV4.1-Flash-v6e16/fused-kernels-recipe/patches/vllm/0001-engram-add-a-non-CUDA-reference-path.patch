+            assert block_table is not None
+            max_blocks = block_table.shape[1]
+            span = torch.clamp(lookback, 0, max_blocks * cache_block_size - 1)
+            block_row = torch.clamp(req, max=block_table.shape[0] - 1)
+            needs_cache = ~in_batch & ~known
+            block = torch.where(
+                needs_cache,
+                block_table.to(torch.int64)[block_row, span // cache_block_size],
+                0,
+            )
+            slot = torch.clamp(
+                block * cache_block_size + span % cache_block_size,
+                0,
+                cache.shape[0] - 1,
