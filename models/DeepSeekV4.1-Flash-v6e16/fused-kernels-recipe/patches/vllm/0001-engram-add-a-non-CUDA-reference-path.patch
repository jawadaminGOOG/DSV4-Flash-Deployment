+    def _lookup_reference(self, indices: torch.Tensor, out: torch.Tensor) -> None:
+        """Gather and dequantize with plain tensor ops, for platforms with no
+        Triton lookup kernel.
+
+        Same result as `_engram_lookup_kernel`: this rank's head columns are
+        gathered, rows outside this rank's vocabulary window write zeros, and
+        head columns past the end of the table write zeros too. When the shard
+        lives on the host the gather runs there, and only the gathered rows,
+        not the table, move to the accelerator.
+        """
+        num_tokens = indices.shape[0]
+        local_heads = self.part_n_hash_cols
+        weight, scales = self.weight.data, self.weight_scale_inv.data
+
+        columns = indices[:, self.head_start : self.head_start + local_heads]
+        missing = local_heads - columns.shape[1]
+        if missing > 0:
+            # This rank owns fewer head columns than it reports. -1 never falls
+            # inside the vocabulary window, so those columns come back zero.
+            columns = torch.nn.functional.pad(columns, (0, missing), value=-1)
+        columns = columns.to(weight.device)
+
+        owned = (columns >= self.vocab_start_idx) & (columns < self.vocab_end_idx)
+        rows = torch.where(owned, columns - self.vocab_start_idx, 0).long()
+
+        values = weight[rows].to(torch.float32)
+        # A ue8m0 byte is a power of two, so it *is* the fp32 exponent field.
+        scale = (scales[rows].to(torch.int32) << 23).view(torch.float32)
+        values = values * scale.repeat_interleave(self.block_size, dim=-1)
+        values = torch.where(owned.unsqueeze(-1), values, 0.0)
+        out.copy_(values.to(torch.bfloat16).to(out.device), non_blocking=True)
