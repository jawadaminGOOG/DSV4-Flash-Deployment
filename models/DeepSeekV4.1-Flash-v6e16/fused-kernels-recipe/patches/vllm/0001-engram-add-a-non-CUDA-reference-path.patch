+        known = in_window & (window_id >= 0)
+        window_source = torch.where(known, token_map[torch.clamp(window_id, min=0)], 0)
+        window_dead = lookback_dead_mask.to(torch.bool)[req, column] & known
+        window_source = torch.where(window_dead, DEAD_ID, window_source)
+
