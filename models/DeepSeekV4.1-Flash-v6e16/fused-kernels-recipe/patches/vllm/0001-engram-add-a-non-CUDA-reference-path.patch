+def _fused_engram_post_wkv_reference(
+    hidden_states: torch.Tensor,
+    kv: torch.Tensor,
+    q_weight: torch.Tensor,
+    k_weight: torch.Tensor,
+    token_mask: torch.Tensor | None,
+    num_kv_tokens: int,
+    eps: float,
+    clamp_value: float,
+) -> torch.Tensor:
+    """Plain-tensor form of `_fused_engram_post_wkv_kernel`.
+
+    The gate is a normalized dot product of the residual stream against the
+    n-gram key, signed-sqrt'ed before the sigmoid. Rows at or past
+    `num_kv_tokens` read a zero key and a zero value, so they pass the stream
+    through unchanged, which is what the kernel's load masks do.
+    """
+    num_tokens, hc_mult, dim = hidden_states.shape
+    hidden = hidden_states.to(torch.float32)
+
+    if kv.shape[0] < num_tokens:
+        kv = torch.nn.functional.pad(kv, (0, 0, 0, num_tokens - kv.shape[0]))
+    kv = kv[:num_tokens].to(torch.float32)
+    live = (
+        torch.arange(num_tokens, device=hidden.device) < num_kv_tokens
+    ).unsqueeze(-1)
+
+    key = torch.where(live.unsqueeze(-1), kv[:, : hc_mult * dim].view(
+        num_tokens, hc_mult, dim), 0.0)
+    value = torch.where(live, kv[:, hc_mult * dim : (hc_mult + 1) * dim], 0.0)
+
+    hidden_rms = torch.rsqrt(hidden.pow(2).sum(-1) / dim + eps)
+    key_rms = torch.rsqrt(key.pow(2).sum(-1) / dim + eps)
+    dot = (hidden * q_weight.to(torch.float32) * k_weight.to(torch.float32) * key).sum(-1)
+    dot = dot * hidden_rms * key_rms * (dim**-0.5)
+
+    gate = torch.sqrt(torch.clamp(dot.abs(), min=clamp_value))
+    gate = torch.sigmoid(torch.where(dot < 0.0, -gate, gate))
+    if token_mask is not None:
+        gate = torch.where(token_mask.to(torch.bool).unsqueeze(-1), gate, 0.0)
+
+    return (hidden + gate.unsqueeze(-1) * value.unsqueeze(1)).to(hidden_states.dtype)
+
+
