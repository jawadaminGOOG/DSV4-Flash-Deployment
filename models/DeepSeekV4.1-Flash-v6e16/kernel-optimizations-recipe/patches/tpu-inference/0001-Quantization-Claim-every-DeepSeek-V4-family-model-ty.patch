+"""Model-type resolution for the "deepseek_v4_fp8" quantization config.
+
+A DeepSeek V4 family checkpoint reaches VllmMxfp4MoEMethod only when this config
+claims it. A model type that no registered config claims falls back to plain FP8,
+its packed E2M1 expert pairs are then read as FP8, and the int8 expert lever never
+runs. Nothing raises when that happens, so these tests hold the resolution.
+"""
+
+import types
+
+import pytest
+from vllm.model_executor.layers.quantization import get_quantization_config
+
+from tpu_inference.layers.common.quant_methods import DSV4_FP8
+from tpu_inference.layers.vllm.quantization.deepseek_v4_fp8 import \
+    VllmDeepseekV4Fp8Config
+
+# Every DeepSeek V4 family checkpoint writes "fp8" as its quant_method and carries
+# the real expert dtype in "expert_dtype". Taken from the published config.json.
+_HF_QUANT_CFG = {
+    "quant_method": "fp8",
+    "activation_scheme": "dynamic",
+    "weight_block_size": [32, 32],
+    "scale_fmt": "ue8m0",
+    "expert_dtype": "fp4",
+}
+
+_UNSET = object()
+
+
+def _resolve(model_type, hf_quant_cfg=_UNSET, user_quant=None):
+    hf_config = types.SimpleNamespace(model_type=model_type)
+    if hf_quant_cfg is _UNSET:
+        hf_quant_cfg = _HF_QUANT_CFG
+    return VllmDeepseekV4Fp8Config.override_quantization_method(
+        hf_quant_cfg, user_quant, hf_config)
+
+
+@pytest.mark.parametrize("model_type", [
+    "deepseek_v4",
+    "deepseek_v4_text",
+    "deepseek_v41",
+    "deepseek_v41_text",
+])
+def test_every_deepseek_v4_family_type_claims_the_deepseek_fp8_path(
+        model_type):
+    assert _resolve(model_type) == DSV4_FP8
+
+
+def test_this_config_owns_the_registered_name():
+    # register_quantization_config overwrites an existing name and logs only at
+    # debug level, so the winner is worth asserting.
+    assert get_quantization_config(DSV4_FP8) is VllmDeepseekV4Fp8Config
+
+
+def test_an_explicit_user_choice_still_wins():
+    assert _resolve("llama", user_quant=DSV4_FP8) == DSV4_FP8
+
+
+def test_a_foreign_model_type_is_left_alone():
+    assert _resolve("llama") is None
+
+
+def test_a_non_fp8_checkpoint_is_left_alone():
+    cfg = dict(_HF_QUANT_CFG, quant_method="awq")
+    assert _resolve("deepseek_v41", hf_quant_cfg=cfg) is None
+
+
+def test_a_quant_config_that_is_not_a_dict_is_left_alone():
+    assert _resolve("deepseek_v41", hf_quant_cfg="fp8") is None
+
+
+def test_a_missing_hf_config_is_left_alone():
+    assert VllmDeepseekV4Fp8Config.override_quantization_method(
+        _HF_QUANT_CFG, None, None) is None
diff --git a/tpu_inference/layers/vllm/quantization/deepseek_v4_fp8.py b/tpu_inference/layers/vllm/quantization/deepseek_v4_fp8.py
index f4b24271..59400ef5 100644
--- a/tpu_inference/layers/vllm/quantization/deepseek_v4_fp8.py
+++ b/tpu_inference/layers/vllm/quantization/deepseek_v4_fp8.py
@@ -46,10 +46,35 @@ class VllmDeepseekV4Fp8Config(DeepseekV4FP8Config, VllmQuantConfig):
     Linear layers always use VllmFp8LinearMethod (FP8 block-quant).
     """
 
+    # Model types this config claims beyond the ones the base class already
+    # claims. Every DeepSeek V4 family checkpoint writes "fp8" as its
+    # quant_method and carries the real expert dtype in "expert_dtype", so a
+    # model type that no registered config claims here falls back to plain FP8
+    # and its packed MXFP4 experts are then read as FP8.
+    _EXTRA_MODEL_TYPES = ("deepseek_v4_text", "deepseek_v41",
+                          "deepseek_v41_text")
+
     @classmethod
     def get_name(cls) -> str:
         return DSV4_FP8
 
+    @classmethod
+    def override_quantization_method(cls, hf_quant_cfg, user_quant,
+                                     hf_config=None) -> Optional[str]:
+        # The base class handles the model types it knows, including the
+        # AMD-Quark MXFP4 exports, so ask it first and only widen the answer.
+        claimed = super().override_quantization_method(
+            hf_quant_cfg, user_quant, hf_config)
+        if claimed is not None:
+            return claimed
+        if not isinstance(hf_quant_cfg, dict):
+            return None
+        if hf_quant_cfg.get("quant_method") not in ("fp8", DSV4_FP8):
+            return None
+        if getattr(hf_config, "model_type", None) in cls._EXTRA_MODEL_TYPES:
+            return DSV4_FP8
+        return None
+
     def get_quant_method(
         self,
         layer: torch.nn.Module,
