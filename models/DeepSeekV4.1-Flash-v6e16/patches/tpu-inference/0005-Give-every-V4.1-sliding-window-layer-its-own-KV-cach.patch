+            reserved += max(here, there)
+            row[0] += max(here, there)
+            row[1] += 1
+            row[2] = str(data.dtype)
+            row[3] = tuple(data.shape)
+            if there > here:
+                worst.append((there - here, key, data.shape, here, there))
