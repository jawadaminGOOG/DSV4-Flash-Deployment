+"""Host-side n-gram hash and Engram row gather for TPU.
+
+The DeepSeek V4.1 Engram tables hold about 92 GiB each. Two of them plus the
+rest of the weights do not fit in the HBM of a v6e slice, so the tables stay in
+host memory. A TPU program cannot address host memory, so the lookup cannot run
+inside the traced step function.
+
+This module runs the whole Engram lookup on the host, before the step function
+starts:
+
+1. It hashes the n-grams that end at each token.
+2. It gathers and dequantizes the rows those hashes name.
+3. It returns one bf16 array for the step function to consume.
+
+The step function then hands the rows to `ParallelEngramEmbedding`, which reads
+them instead of the table. The hash and the gather both reuse the model's own
+reference implementations, so the result matches the accelerator path.
+"""
+
+from __future__ import annotations
+
+import ml_dtypes
+import numpy as np
+import torch
+
+from tpu_inference.logger import init_logger
+
+logger = init_logger(__name__)
+
+
+#: Attributes that a loader wrapper uses to hold the model it wraps. The
+#: runner receives the outermost wrapper, and only the innermost object is a
+#: `torch.nn.Module`.
+_WRAPPER_ATTRS = ("model", "vllm_model", "module")
+
+
+def _first_torch_module(obj: object, depth: int = 4) -> "torch.nn.Module|None":
+    """Descend through loader wrappers to the first `torch.nn.Module`.
+
+    Return None when no wrapper attribute leads to one inside `depth` steps.
+    """
+    for _ in range(depth):
+        if isinstance(obj, torch.nn.Module):
+            return obj
+        for attr in _WRAPPER_ATTRS:
+            inner = getattr(obj, attr, None)
+            if inner is not None and inner is not obj:
+                obj = inner
+                break
+        else:
+            return None
+    return obj if isinstance(obj, torch.nn.Module) else None
+
+
+def maybe_build_engram_host_lookup(model: object) -> "EngramHostLookup | None":
+    """Return a lookup for `model`, or None when it needs no host gather.
+
+    Safe to call for any model. Only a model whose layers hold an Engram module
+    gets one back.
+    """
+    if model is None:
+        return None
+    lookup = EngramHostLookup(model)
+    return lookup if lookup.enabled else None
+
+
+def _to_host(tensor: torch.Tensor) -> torch.Tensor:
+    """Return a plain CPU torch tensor, whatever backend holds `tensor`."""
+    if type(tensor) is torch.Tensor and tensor.device.type == "cpu":
+        return tensor
+    from torchax.interop import jax_view
+    import jax
+    return torch.from_numpy(np.asarray(jax.device_get(jax_view(tensor))))
+
+
+class EngramHostLookup:
+    """Hashes and gathers Engram rows on the host for one model instance.
+
+    Build one per model. `gather` returns
+    `[num_engram_layers, num_tokens, n_hash_cols, head_dim]` bf16, which is the
+    same value `ParallelEngramEmbedding.lookup` writes on an accelerator that
+    can address the table.
+    """
+
+    def __init__(self, model: object) -> None:
+        self._hash_state = None
+        self._layout = None
+        self._embeddings: list = []
+        self._tables: dict[str, torch.Tensor] | None = None
+        self.lookback_depth = 0
+        self.n_hash_cols = 0
+        self.head_dim = 0
+        # The runner holds a wrapper, not the decoder, and how deep the decoder
+        # sits varies by loader. Descend to the first `torch.nn.Module`, then
+        # search that tree by attribute instead of by path.
+        root = _first_torch_module(model)
+        if root is None:
+            logger.info(
+                "No Engram host lookup: %s holds no torch module to search.",
+                type(model).__name__)
+            return
+        backbone = None
+        for module in root.modules():
+            if getattr(module, "engram_hash", None) is not None:
+                backbone = module
+                break
+        if backbone is None:
+            logger.info(
+                "No Engram host lookup: no module under %s has an "
+                "`engram_hash`.",
+                type(root).__name__)
+            return
+        self._hash_state = backbone.engram_hash
+        self._layout = backbone.engram_layout
+        for layer in backbone.layers:
+            engram = getattr(layer, "engram", None)
+            if engram is not None:
+                self._embeddings.append(engram.embed_tokens)
+        if not self._embeddings:
+            # The model declares the hash state but holds no Engram layer, so
+            # this rank has nothing to gather.
+            logger.info(
+                "No Engram host lookup: %s declares an `engram_hash` but "
+                "holds no Engram layer on this rank.",
+                type(backbone).__name__)
+            return
+        self.lookback_depth = self._hash_state.lookback_depth
+        # Read the row shape off an embedding, not off the layout: an embedding
+        # returns only the head columns its own rank owns.
+        self.n_hash_cols = self._embeddings[0].part_n_hash_cols
+        self.head_dim = self._embeddings[0].dim
+        logger.info(
+            "Engram host lookup ready: %d table(s), %d hash column(s), "
+            "lookback depth %d.", len(self._embeddings), self.n_hash_cols,
+            self.lookback_depth)
+
+    @property
+    def enabled(self) -> bool:
+        """True when this model has Engram layers to gather for."""
+        return bool(self._embeddings)
+
+    @property
+    def num_tables(self) -> int:
+        """How many Engram tables this rank holds, one per Engram layer."""
+        return len(self._embeddings)
+
+    def row_shape(self, num_tokens: int) -> tuple[int, int, int, int]:
+        """Shape of the array `gather_rows` returns for `num_tokens` tokens.
+
+        Precompilation needs this before any real tokens exist, so that the
+        compiled step function takes the same shape the runner later passes.
+        """
+        return (self.num_tables, num_tokens, self.n_hash_cols, self.head_dim)
+
+    def ready(self) -> bool:
+        """True when the KV cache is bound, so the rows are used this step.
+
+        A profile run leaves the KV cache unbound. The model skips the Engram
+        layers then, so the gather would be wasted work.
+        """
+        return self.enabled and self._hash_state.ensure_cache()
+
+    def _host_tables(self) -> dict[str, torch.Tensor]:
+        """CPU copies of the four constant hash tables, built once.
+
+        The tables are registered buffers, so the weight loader may have moved
+        them to the accelerator. They are small and never change, so one copy
+        back to the host serves every step.
+        """
+        if self._tables is None:
+            state = self._hash_state
+            self._tables = {
+                name: _to_host(getattr(state, name))
+                for name in ("token_map", "multipliers", "primes", "offsets")
+            }
+        return self._tables
+
+    def hashes(
+        self,
+        input_ids: np.ndarray,
+        positions: np.ndarray,
+        query_start_loc: np.ndarray,
+        lookback_token_ids: np.ndarray,
+    ) -> torch.Tensor:
+        """Hash ids for every token, shaped [tokens, layers, hash columns].
+
+        All four inputs are host arrays. `lookback_token_ids[req, k]` is the
+        token `k + 1` positions before the request's first scheduled token, or
+        -1 where no such token exists.
+        """
+        from vllm.models.deepseek_v4_1.common.engram import _hash_ids_reference
+        from vllm.models.deepseek_v4_1.common.mm_preprocess import \
+            image_sentinel_mask
+
+        tables = self._host_tables()
+        ids = torch.from_numpy(np.ascontiguousarray(input_ids)).to(torch.int32)
+        lookback = torch.from_numpy(
+            np.ascontiguousarray(lookback_token_ids)).to(torch.int32)
+        num_layers, max_ngram = tables["multipliers"].shape
+        num_heads = tables["primes"].shape[-1]
+        output = torch.empty(
+            (ids.shape[0], num_layers, (max_ngram - 1) * num_heads),
+            dtype=torch.int32,
+        )
+        _hash_ids_reference(
+            ids,
+            tables["token_map"],
+            image_sentinel_mask(ids),
+            torch.from_numpy(np.ascontiguousarray(positions)).to(torch.int32),
+            None,
+            torch.from_numpy(np.ascontiguousarray(query_start_loc)).to(
+                torch.int32),
+            tables["multipliers"],
+            tables["primes"],
+            tables["offsets"],
+            None,
+            lookback,
+            image_sentinel_mask(lookback),
+            output,
+            self._hash_state.pad_id,
+            self._hash_state.block_size,
+        )
+        return output
+
+    def gather_rows(self, hash_chunks: list) -> np.ndarray:
+        """Gather the rows that `hash_chunks` name, as one host array.
+
+        Each chunk comes from `hashes`. A caller that hashes one data-parallel
+        rank at a time passes the chunks in token order, and this joins them, so
+        the gather runs once for the whole step.
+
+        The result is [tables, tokens, hash columns, head dim] bfloat16. Torch
+        cannot hand a bfloat16 tensor to NumPy, so the bytes travel as uint16
+        and `ml_dtypes` relabels them without a copy.
+        """
+        hash_ids = (hash_chunks[0]
+                    if len(hash_chunks) == 1 else torch.cat(hash_chunks, dim=0))
+        rows = [
+            embedding.gather_on_host(hash_ids[:, index])
+            for index, embedding in enumerate(self._embeddings)
+        ]
+        stacked = torch.stack(rows, dim=0)
+        return stacked.view(torch.uint16).numpy().view(ml_dtypes.bfloat16)
