     return jnp.reshape(e2m1, e2m1.shape[:-2] + (-1, ))
 
 
+def u8_unpack_e2m1_code(u8_packed_e2m1: jax.Array) -> jax.Array:
+    """Unpack an e2m1 tensor packed into u8, and keep the four-bit code.
+
+    `u8_unpack_e2m1` returns `float4_e2m1fn` values. A TPU generation without an
+    FP4 matrix unit cannot lower a vector of that dtype, so this function
+    returns the same bits in `int4` storage. The bit order is the same, and the
+    sign bit of the code is the sign bit of the `int4`, so a consumer decodes
+    the code to its value with plain arithmetic.
+    """
+    assert u8_packed_e2m1.dtype == jnp.uint8
+    code = jax.lax.bitcast_convert_type(u8_packed_e2m1, jnp.int4)
+    # bitcast creates one more dimension that splits 8 bits into two codes.
+    # we flatten them with the last dim.
+    return jnp.reshape(code, code.shape[:-2] + (-1, ))
+
