+# The MXFP4 encoding. The right-hand side holds an E2M1 code in `int4` storage,
+# and its scale holds an E8M0 exponent in `uint8` storage. A TPU generation
+# without an FP4 matrix unit cannot lower a `float4_e2m1fn` vector, and holding
+# the same bits in `int4` keeps the four-bit footprint and lowers everywhere.
+MXFP4_ENCODING = "mxfp4"
+
+# E8M0 stores an exponent and no mantissa, biased by 127.
+_E8M0_EXPONENT_BIAS = 127
+
+
+def decode_e2m1(code: jax.Array, dtype: jnp.dtype) -> jax.Array:
+    """Return the E2M1 value of a four-bit code held in `int4`.
+
+    The code carries the FP4 bit pattern, so the sign bit of the `int4` is the
+    sign of the value, and the low three bits select one of eight magnitudes.
+    Two's complement makes the sign test a comparison against zero.
+    """
+    wide = code.astype(jnp.int32)
+    index = jax.lax.bitwise_and(wide, 7)
+    # The first five magnitudes are half the index. The last three are not.
+    magnitude = 0.5 * index.astype(jnp.float32)
+    magnitude = jnp.where(index == 5, 3.0, magnitude)
+    magnitude = jnp.where(index == 6, 4.0, magnitude)
+    magnitude = jnp.where(index == 7, 6.0, magnitude)
+    return jnp.where(wide < 0, -magnitude, magnitude).astype(dtype)
+
+
+def infer_rhs_encoding(rhs: jax.Array,
+                       rhs_scale: jax.Array | None) -> str | None:
+    """Return the encoding that the rhs storage and its scale dtype imply.
+
+    A `uint8` scale holds an E8M0 exponent, and MXFP4 is the only format that
+    uses one. Every other quantized weight carries a floating scale. So a
+    four-bit weight with a `uint8` scale is MXFP4 and nothing else.
+    """
+    if rhs_scale is None:
+        return None
+    if (rhs_scale.dtype == jnp.uint8
+            and jax.dtypes.itemsize_bits(rhs.dtype) == 4):
+        return MXFP4_ENCODING
+    return None
+
+
+def decode_e8m0(scale: jax.Array, dtype: jnp.dtype) -> jax.Array:
+    """Return the value of an E8M0 scale held in `uint8`."""
+    exponent = scale.astype(jnp.float32) - _E8M0_EXPONENT_BIAS
+    return jnp.exp2(exponent).astype(dtype)
+
+
