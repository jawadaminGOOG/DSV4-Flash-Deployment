+    def _engram_lookback(self, req_indices: np.ndarray, num_rows: int,
+                         depth: int) -> np.ndarray:
+        """The tokens just before each request's first scheduled token.
+
+        Returns [num_rows, depth] int32. Entry [row, k] is the token `k + 1`
+        positions before the first token this step schedules for that request,
+        or -1 when the request has no such token. A row past the end of
+        `req_indices` is a padding row and is all -1.
+
+        The n-gram that ends at a request's first scheduled token reaches back
+        into tokens this step does not schedule. Only the runner holds them.
+        """
+        lookback = np.full((num_rows, depth), -1, dtype=np.int32)
+        token_ids = self.input_batch.token_ids_cpu
+        computed = self.input_batch.num_computed_tokens_cpu
+        for row, req in enumerate(req_indices[:num_rows]):
+            start = int(computed[req])
+            take = min(depth, start)
+            if take > 0:
+                lookback[row, :take] = token_ids[req,
+                                                 start - take:start][::-1]
+        return lookback
+
+    def _gather_engram_rows(
+        self,
+        input_ids: np.ndarray,
+        positions: np.ndarray,
+        query_start_loc: np.ndarray,
+        req_indices_dp: List[np.ndarray],
+        dp_size: int,
+        tokens_per_dp_rank: int,
+        max_num_reqs_per_dp_rank: int,
+    ) -> Optional[jax.Array]:
+        """Gather this step's Engram rows on the host, or return None.
+
+        An Engram table is far larger than device memory allows, so it stays in
+        host memory and the step function cannot read it. Gather the rows here
+        instead, while the inputs are still host arrays, and hand them to the
+        step function. Returns None for a model with no such table, and for a
+        profile run, where the model reads no rows.
+
+        Each data-parallel rank owns one contiguous token range and its own
+        request rows, so hash one rank at a time. The gather then runs once, on
+        the joined hashes.
+        """
+        lookup = self.engram_host_lookup
+        if lookup is None or not lookup.ready():
+            return None
+
+        chunks = []
+        for dp_rank in range(dp_size):
+            token_start = dp_rank * tokens_per_dp_rank
+            loc_start = dp_rank * (max_num_reqs_per_dp_rank + 1)
+            chunks.append(
+                lookup.hashes(
+                    input_ids[token_start:token_start + tokens_per_dp_rank],
+                    positions[token_start:token_start + tokens_per_dp_rank],
+                    query_start_loc[loc_start:loc_start +
+                                    max_num_reqs_per_dp_rank + 1],
+                    self._engram_lookback(req_indices_dp[dp_rank],
+                                          max_num_reqs_per_dp_rank,
+                                          lookup.lookback_depth),
+                ))
+        return device_array(self.mesh,
+                            lookup.gather_rows(chunks),
+                            sharding=NamedSharding(self.mesh, PartitionSpec()))
