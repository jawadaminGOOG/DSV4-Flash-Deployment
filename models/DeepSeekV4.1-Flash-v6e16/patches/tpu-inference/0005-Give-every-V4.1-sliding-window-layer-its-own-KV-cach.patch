+def _log_resident_weight_bytes(params_and_buffers: dict) -> None:
+    """Log how much device memory the sharded weights actually take.
+
+    A weight can take more memory on the chip than it takes in the checkpoint.
+    Three mechanisms widen it, and the checkpoint inventory shows none of them:
+    the loader requantizes a sub-byte weight to a wider type, a kernel pads an
+    axis to its own block size, and a shard that does not land on a tile
+    boundary is padded to one. Report the addressable bytes, the bytes that the
+    runtime reserves, and a breakdown by weight family with the dtype and the
+    shard shape. Then you can check a memory budget against the hardware
+    instead of against arithmetic over the checkpoint.
+    """
+    gib = 1024**3
+    logical = 0
+    reserved = 0
+    families: dict[str, list] = {}
+    worst: list[tuple[int, str, tuple, int, int]] = []
+    for key, value in params_and_buffers.items():
+        array = jax_view(value)
+        if not hasattr(array, "addressable_shards"):
+            continue
+        row = families.setdefault(_weight_family(key), [0, 0, None, None])
+        for shard in array.addressable_shards:
