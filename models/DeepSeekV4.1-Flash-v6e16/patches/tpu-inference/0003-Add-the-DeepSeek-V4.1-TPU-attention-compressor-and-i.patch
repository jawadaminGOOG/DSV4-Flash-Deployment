+"""TPU-compatible DeepSeek-V4.1 KV compressor.
+
+The V4.1 compressor is not the V4 compressor with different arguments. It
+pools a group of ``compress_ratio`` tokens with a learned softmax gate, where
+V4 pooled with an absolute positional embedding, and it splits one call into
+two:
+
+* ``forward(kv_score, positions)`` saves the open group's rows, pools every
+  closed group, applies the RMSNorm and returns a BF16 latent.
+* ``insert_cache(latent, positions, rotary_emb)`` applies RoPE to the latent
+  and publishes it to the compressed KV cache.
+
+The attention layer runs the ``fused_wkv_wgate`` projection itself, so this
+module receives ``kv_score`` rather than ``hidden_states``. The V4 TPU
+compressor consumes ``hidden_states`` and fuses that projection into its
+Pallas kernel, which is one more reason the two cannot share code.
+
+Cache layouts this module expects the runner to allocate:
+
+* state cache, ratio 2 only: ``float32 [num_blocks, capacity, 2 * head_dim]``.
+  The first ``head_dim`` channels hold the KV row and the rest hold the gate
+  score. A request keeps one block. Position ``p`` occupies row
+  ``p % capacity``.
+* compressed KV cache, two ``uint8`` arrays. The main array holds a 512-byte
+  record for each state: 448 FP8 E4M3 values, then seven E8M0 scale bytes, one
+  for each block of 64 values. The companion ``{prefix}_rope`` array holds a
+  128-byte record: the 64 rotary channels in BF16.
+
+The packed record is not a choice about memory. It is the layout that the
+tuned ``sparse_ragged_paged_attention`` kernel reads, and writing anything else
+would mean writing a second sparse attention kernel.
+"""
+
+import jax
+import jax.numpy as jnp
+import torch
+from jax.sharding import PartitionSpec as P
+from torchax.interop import jax_view, torch_view
+from vllm.config import VllmConfig
+from vllm.forward_context import get_forward_context
+from vllm.models.deepseek_v4_1 import compressor as dsv41_compressor
+from vllm.models.deepseek_v4_1.compressor import (CompressorStateCache,
+                                                  DeepseekCompressor)
+from vllm.v1.kv_cache_interface import KVCacheSpec, SlidingWindowMLASpec
+
+from tpu_inference.layers.common.sharding import ShardingAxisName
+from tpu_inference.logger import init_logger
+from tpu_inference.models.vllm.vllm_model_wrapper_context import \
+    get_vllm_model_wrapper_context
+
+logger = init_logger(__name__)
+
+# The rotary channels of the compressed latent. The leading channels carry no
+# position, so their rotation is the identity.
+ROPE_CHANNELS = 64
+# The non-rotary channels, quantized to FP8 with one E8M0 scale for each block.
+NOPE_CHANNELS = 448
+QUANT_BLOCK = 64
+FP8_MAX = 448.0
+
+
+def quantize_e8m0(x: jax.Array, block: int) -> tuple[jax.Array, jax.Array]:
+    """FP8 E4M3 values with one E8M0 scale byte for each block of channels.
+
+    A reader recovers a value with ``value * 2 ** (scale_byte - 127)``.
+    """
+    rows = x.shape[0]
+    blocks = x.reshape(rows, -1, block)
+    amax = jnp.maximum(jnp.max(jnp.abs(blocks), axis=-1, keepdims=True), 1e-4)
+    exponent = jnp.ceil(jnp.log2(amax / FP8_MAX))
+    scaled = jnp.clip(blocks * jnp.exp2(-exponent), -FP8_MAX, FP8_MAX)
+    values = scaled.astype(jnp.float8_e4m3fn).view(jnp.uint8).reshape(rows, -1)
+    encoded = jnp.clip(exponent[..., 0] + 127.0, 0.0, 255.0).astype(jnp.uint8)
+    return values, encoded
+
+
+def _token_request_ids(query_start_loc: jax.Array,
+                       num_tokens: int) -> jax.Array:
+    """Request index of each packed token row.
+
+    vLLM's CUDA path receives this array in the metadata. The TPU metadata
+    carries only ``query_start_loc``, so derive it here.
+    """
+    tokens = jnp.arange(num_tokens, dtype=jnp.int32)
+    return (jnp.searchsorted(query_start_loc, tokens, side="right") -
+            1).astype(jnp.int32)
+
+
+def _rms_norm(x: jax.Array, weight: jax.Array, eps: float) -> jax.Array:
+    """RMSNorm over the last axis, accumulated in float32.
+
+    V4.1-Flash sets ``rms_norm_eps`` to 1e-20. A BF16 accumulation makes an
+    epsilon that small meaningless, so the caller must pass float32.
+    """
+    variance = jnp.mean(jnp.square(x), axis=-1, keepdims=True)
+    return x * jax.lax.rsqrt(variance + eps) * weight.astype(jnp.float32)
+
+
+def _gptj_rope(x: jax.Array, positions: jax.Array,
+               cos_sin_cache: jax.Array) -> jax.Array:
+    """GPT-J interleaved RoPE on the trailing ``ROPE_CHANNELS`` of ``x``.
+
+    ``cos_sin_cache`` is ``[max_position, 2 * ROPE_CHANNELS // 2]``: the first
+    half holds cosines and the second half holds sines.
+    """
+    half = ROPE_CHANNELS // 2
+    head = x[:, :-ROPE_CHANNELS]
+    tail = x[:, -ROPE_CHANNELS:].reshape(x.shape[0], half, 2)
+    cos_sin = cos_sin_cache[positions].astype(jnp.float32)
+    cos = cos_sin[:, :half, None]
+    sin = cos_sin[:, half:, None]
+    even = tail[:, :, 0:1]
+    odd = tail[:, :, 1:2]
+    rotated = jnp.concatenate([even * cos - odd * sin, odd * cos + even * sin],
+                              axis=-1)
+    return jnp.concatenate([head, rotated.reshape(x.shape[0], ROPE_CHANNELS)],
+                           axis=-1)
+
+
+def _paged_slots(block_tables: jax.Array, request_ids: jax.Array,
+                 row_indices: jax.Array, num_requests: int,
+                 page_size: int) -> jax.Array:
+    """Flat ``block * page_size + offset`` slot of each token row.
+
+    ``block_tables`` arrives flattened as ``num_requests *
+    max_blocks_per_request``.
+    """
+    max_blocks = block_tables.shape[0] // num_requests
+    blocks = block_tables.reshape(num_requests, max_blocks)
+    page = row_indices // page_size
+    page = jnp.clip(page, 0, max_blocks - 1)
+    return blocks[request_ids, page] * page_size + row_indices % page_size
+
+
+class VllmDeepseekV41CompressorStateCache(CompressorStateCache):
+    """TPU-compatible compressor state cache.
+
+    The base ``get_kv_cache_spec`` returns a ``CircularBufferSpec`` describing
+    the CUDA ring layout. The TPU runner plans its own arrays, so this override
+    reports the same capacity through the spec type the TPU KV-cache manager
+    already understands.
+    """
+
+    def get_kv_cache_spec(self, vllm_config: VllmConfig) -> KVCacheSpec:
+        del vllm_config
+        # The ring holds one block for each request, so a sliding window equal
+        # to the ring capacity gives the allocator the right per-request
+        # budget. The window has no attention meaning here.
+        return SlidingWindowMLASpec(
+            block_size=self.block_size,
+            num_kv_heads=1,
+            head_size=self.state_dim,
+            dtype=self.dtype,
+            sliding_window=self.block_size,
+            alignment=None,
+        )
+
+
+class VllmDeepseekV41Compressor(DeepseekCompressor):
+    """TPU-compatible DeepSeek-V4.1 compressor.
+
+    The base class dispatches to two Triton kernels that TPU does not have.
+    Both are reimplemented here in JAX. The pooling and the RMSNorm run in
+    float32, as the Triton kernels do.
+    """
+
+    def __init__(self, *args, **kwargs):
+        # The base ctor builds ``self.state_cache`` from the vLLM
+        # ``CompressorStateCache``. Temporarily rebind the symbol the base ctor
+        # references so it constructs the TPU subclass directly.
+        orig_state_cache = dsv41_compressor.CompressorStateCache
+        dsv41_compressor.CompressorStateCache = (
+            VllmDeepseekV41CompressorStateCache)
+        try:
+            super().__init__(*args, **kwargs)
+        finally:
+            dsv41_compressor.CompressorStateCache = orig_state_cache
+        self._wkv_wgate_transposed = False
+
+    def transpose_wkv_wgate(self) -> None:
+        """Stores ``fused_wkv_wgate.weight`` transposed, once, at load time.
+
+        vLLM lays linear weights out as [out_features, in_features]. The
+        attention layer multiplies ``hidden_states`` by this weight, so the
+        transposed layout removes a transpose from every step.
+        """
+        if self._wkv_wgate_transposed:
+            return
+        weight = self.fused_wkv_wgate.weight.data.t().contiguous()
+        self.fused_wkv_wgate.weight = torch.nn.Parameter(weight,
+                                                         requires_grad=False)
+        self._wkv_wgate_transposed = True
+
+    def forward(
+        self,
+        # [num_tokens, (2 if has_gate else 1) * head_dim], float32
+        kv_score: torch.Tensor,
+        # [num_tokens], int64
+        positions: torch.Tensor,
+    ) -> torch.Tensor | None:
+        """Save the open group's rows, pool every closed group, normalize.
+
+        Returns the BF16 latent. Rows that do not close a group hold values
+        that no consumer reads; ``insert_cache`` and the indexer both mask on
+        the same group-boundary test.
+        """
+        attn_metadata = get_forward_context().attn_metadata
+        if not isinstance(attn_metadata, dict):
+            return None
+
+        if self.state_cache is None:
+            return self._forward_ratio_one(kv_score)
+        return self._forward_ratio_two(kv_score, positions, attn_metadata)
+
+    def _forward_ratio_one(self, kv_score: torch.Tensor) -> torch.Tensor:
+        """Ratio 1: every token is its own group, so pooling is the identity."""
+        mesh = get_vllm_model_wrapper_context().mesh
+        data_spec = P(ShardingAxisName.ATTN_DATA)
+        eps = self.rms_norm_eps
+
+        def _normalize(kv_score, weight):
+            return _rms_norm(kv_score.astype(jnp.float32), weight,
+                             eps).astype(jnp.bfloat16)
+
+        latent = jax.shard_map(
+            _normalize,
+            mesh=mesh,
+            in_specs=(data_spec, P()),
+            out_specs=data_spec,
+            check_vma=False,
+        )(jax_view(kv_score), jax_view(self.norm.weight))
+        return torch_view(latent)
+
+    def _forward_ratio_two(self, kv_score: torch.Tensor,
+                           positions: torch.Tensor,
+                           attn_metadata: dict) -> torch.Tensor:
+        """Ratio 2: pool each closed pair with the gate, then refill the ring.
+
+        A group is the token pair ending at an odd position. The first token of
+        a chunk pools against a row the previous chunk left in the ring, so the
+        ring is read before it is written. JAX makes that ordering explicit:
+        the gather reads the array this call received and the scatter produces
+        a new one.
+        """
+        wrapper_ctx = get_vllm_model_wrapper_context()
+        mesh = wrapper_ctx.mesh
+        state_metadata = attn_metadata[self.state_cache.prefix]
+        state_index = wrapper_ctx.layer_name_to_kvcache_index[
+            self.state_cache.prefix]
+        state_cache = wrapper_ctx.kv_caches[state_index]
+
+        eps = self.rms_norm_eps
+        head_dim = self.head_dim
+        # A ratio above 2 would pool more than two rows, and the ring would
+        # have to supply more than one of them.
+        assert self.compress_ratio == 2
+
+        data_spec = P(ShardingAxisName.ATTN_DATA)
+        cache_spec = P(ShardingAxisName.BATCH)
+
+        def _pool(kv_score, positions, query_start_loc, block_tables, ring,
+                  weight):
+            num_tokens = kv_score.shape[0]
+            num_requests = query_start_loc.shape[0] - 1
+            capacity = ring.shape[1]
+            tokens = jnp.arange(num_tokens, dtype=jnp.int32)
+            request_ids = _token_request_ids(query_start_loc, num_tokens)
+            positions = positions.astype(jnp.int32)
+
+            # The ring row of the token before this one, in this token's own
+            # request. Only a chunk's first token reads it.
+            ring_slots = _paged_slots(block_tables, request_ids,
+                                      (positions - 1) % capacity, num_requests,
+                                      capacity)
+            previous_ring = ring.reshape(-1, ring.shape[-1])[ring_slots]
+
+            # The row before this one inside the chunk. Row 0 has none, and
+            # the chunk-start test below discards it.
+            previous_chunk = jnp.roll(kv_score, 1, axis=0)
+            is_chunk_start = tokens == query_start_loc[request_ids]
+            previous = jnp.where(is_chunk_start[:, None], previous_ring,
+                                 previous_chunk)
+
+            pair = jnp.stack([previous, kv_score.astype(jnp.float32)], axis=0)
+            gate = jax.nn.softmax(pair[:, :, head_dim:], axis=0)
+            pooled = jnp.sum(pair[:, :, :head_dim] * gate, axis=0)
+            latent = _rms_norm(pooled, weight, eps).astype(jnp.bfloat16)
+
+            # Refill the ring with the chunk's last ``capacity`` rows. Any
+            # earlier row is already consumed, and writing it would give two
+            # tokens the same ring slot.
+            chunk_end = query_start_loc[request_ids + 1]
+            store = (chunk_end - tokens) <= capacity
+            store_slots = _paged_slots(block_tables, request_ids,
+                                       positions % capacity, num_requests,
+                                       capacity)
+            flat_ring = ring.reshape(-1, ring.shape[-1])
+            # One row past the end absorbs the masked-out writes.
+            store_slots = jnp.where(store, store_slots, flat_ring.shape[0])
+            flat_ring = jnp.concatenate(
+                [flat_ring,
+                 jnp.zeros((1, flat_ring.shape[1]), flat_ring.dtype)],
+                axis=0)
+            flat_ring = flat_ring.at[store_slots].set(
+                kv_score.astype(flat_ring.dtype))
+            return latent, flat_ring[:-1].reshape(ring.shape)
+
+        latent, updated_ring = jax.shard_map(
+            _pool,
+            mesh=mesh,
+            in_specs=(data_spec, data_spec, data_spec, data_spec, cache_spec,
+                      P()),
+            out_specs=(data_spec, cache_spec),
+            check_vma=False,
+        )(
+            jax_view(kv_score),
+            jax_view(positions),
+            state_metadata.query_start_loc,
+            state_metadata.block_tables,
+            state_cache,
+            jax_view(self.norm.weight),
+        )
+        wrapper_ctx.kv_caches[state_index] = updated_ring
+        return torch_view(latent)
+
+    def insert_cache(
+        self,
+        latent: torch.Tensor | None,
+        positions: torch.Tensor,
+        rotary_emb,
+    ) -> None:
+        """Apply RoPE to the latent and publish it to the compressed KV cache.
+
+        Only a token that closes a group writes a row. The rotation uses the
+        position of the group's first token, which is what the CUDA kernel
+        does, so a group's key does not depend on where its boundary falls.
+        """
+        if latent is None:
+            return
+        attn_metadata = get_forward_context().attn_metadata
+        if not isinstance(attn_metadata, dict):
+            return
+
+        wrapper_ctx = get_vllm_model_wrapper_context()
+        mesh = wrapper_ctx.mesh
+        k_cache_metadata = attn_metadata[self.k_cache_prefix]
+        nope_index = wrapper_ctx.layer_name_to_kvcache_index[
+            self.k_cache_prefix]
+        rope_index = wrapper_ctx.layer_name_to_kvcache_index[
+            f"{self.k_cache_prefix}_rope"]
+        nope_cache = wrapper_ctx.kv_caches[nope_index]
+        rope_cache = wrapper_ctx.kv_caches[rope_index]
+
+        ratio = self.compress_ratio
+        data_spec = P(ShardingAxisName.ATTN_DATA)
+        cache_spec = P(ShardingAxisName.BATCH)
+
+        def _insert(latent, positions, query_start_loc, block_tables,
+                    cos_sin_cache, nope_cache, rope_cache):
+            num_tokens = latent.shape[0]
+            num_requests = query_start_loc.shape[0] - 1
+            positions = positions.astype(jnp.int32)
+            request_ids = _token_request_ids(query_start_loc, num_tokens)
+
+            # A latent stands for its whole group, so it rotates at the
+            # position of the group's first token.
+            rotated = _gptj_rope(latent.astype(jnp.float32),
+                                 positions // ratio * ratio, cos_sin_cache)
+            values, scales = quantize_e8m0(rotated[:, :NOPE_CHANNELS],
+                                           QUANT_BLOCK)
+
+            nope_record = jnp.zeros((num_tokens, nope_cache.shape[-1]),
+                                    jnp.uint8)
+            nope_record = nope_record.at[:, :NOPE_CHANNELS].set(values)
+            nope_record = nope_record.at[:, NOPE_CHANNELS:NOPE_CHANNELS +
+                                         scales.shape[1]].set(scales)
+            rope_record = rotated[:, NOPE_CHANNELS:].astype(
+                jnp.bfloat16).view(jnp.uint8)
+
+            closes_group = (positions + 1) % ratio == 0
+            states = positions // ratio
+
+            def _scatter(cache, record):
+                # One record occupies one row of the flattened cache, whatever
+                # the packing axes above it are.
+                page_size = cache.shape[1] * cache.shape[2]
+                flat = cache.reshape(-1, cache.shape[-1])
+                slots = _paged_slots(block_tables, request_ids, states,
+                                     num_requests, page_size)
+                slots = jnp.where(closes_group, slots, flat.shape[0])
+                flat = jnp.concatenate(
+                    [flat, jnp.zeros((1, flat.shape[1]), flat.dtype)], axis=0)
+                return flat.at[slots].set(record)[:-1].reshape(cache.shape)
+
+            return _scatter(nope_cache, nope_record), _scatter(
+                rope_cache, rope_record)
+
+        updated_nope, updated_rope = jax.shard_map(
+            _insert,
+            mesh=mesh,
+            in_specs=(data_spec, data_spec, data_spec, data_spec, P(),
+                      cache_spec, cache_spec),
+            out_specs=(cache_spec, cache_spec),
+            check_vma=False,
+        )(
+            jax_view(latent),
+            jax_view(positions),
+            k_cache_metadata.query_start_loc,
+            k_cache_metadata.block_tables,
+            jax_view(rotary_emb.cos_sin_cache),
+            nope_cache,
+            rope_cache,
+        )
+        wrapper_ctx.kv_caches[nope_index] = updated_nope
+        wrapper_ctx.kv_caches[rope_index] = updated_rope
