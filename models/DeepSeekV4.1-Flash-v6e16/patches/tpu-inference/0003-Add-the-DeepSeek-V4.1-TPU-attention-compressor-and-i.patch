+"""TPU-compatible DeepSeek-V4.1 Lightning Indexer.
+
+V4.1 derives the index key from the KV-source layer's compressor latent,
+``k = k_norm(wk(latent))``, where V4 gave the indexer its own compressor over
+the hidden states. So this indexer owns a small K-production step and does not
+own a compressor. Only a layer with ``owns_k`` writes keys; the other index
+sources read the keys that layer published.
+
+The paged K record keeps the layout the TPU ``streamindex_topk`` kernel reads:
+128 FP8 E4M3 value bytes, then one E8M0 scale byte, inside a 256-byte record.
+"""
+
+import functools
+from typing import Optional
+
+import jax
+import jax.numpy as jnp
+import torch
+import torch.nn as nn
+from jax.sharding import PartitionSpec as P
+from torchax.interop import jax_view, torch_view
+from vllm.forward_context import get_forward_context
+from vllm.models.deepseek_v4_1 import attention as dsv41_attention
+from vllm.models.deepseek_v4_1.attention import (DeepseekV4Indexer,
+                                                 DeepseekV4IndexerCache)
+from vllm.v1.kv_cache_interface import MLAAttentionSpec
+
+from tpu_inference.kernels.experimental.deepseek_v4.indexer.streamindex_topk import \
+    streamindex_topk
+from tpu_inference.kernels.experimental.deepseek_v4.rope import rope_quant
+from tpu_inference.layers.common.sharding import ShardingAxisName
+from tpu_inference.layers.vllm.custom_ops.experimental.deepseek_v41.deepseek_v41_compressor import (
+    _gptj_rope, _paged_slots, _rms_norm, _token_request_ids, quantize_e8m0)
+from tpu_inference.logger import init_logger
+from tpu_inference.models.vllm.vllm_model_wrapper_context import \
+    get_vllm_model_wrapper_context
+
+logger = init_logger(__name__)
+
+# The value bytes, the scale byte and the padding of one paged K record.
+INDEXER_RECORD_BYTES = 256
+
+
+def cdiv(a, b):
+    assert b != 0
+    return (a + b - 1) // b
+
+
+def align_to(x, a):
+    return cdiv(x, a) * a
+
+
+def fused_indexer_q_rope_quant(q: torch.Tensor, positions: torch.Tensor,
+                               rotary_emb: torch.nn.Module, mesh):
+    """Applies RoPE and dynamically quantizes the queries."""
+    data_spec = P(ShardingAxisName.ATTN_DATA)
+
+    q_quant_jax, q_scales_jax = jax.shard_map(
+        functools.partial(rope_quant, quant_dtype=jnp.float8_e4m3fn),
+        mesh=mesh,
+        in_specs=(data_spec, data_spec, P()),
+        out_specs=(data_spec, data_spec),
+        check_vma=False,
+    )(jax_view(q), jax_view(positions), jax_view(rotary_emb.cos_sin_cache))
+
+    # vLLM rounds the scale factors up to the next power of two. The standard
+    # division scale the kernel returns, one for each row, is enough here.
+    return torch_view(q_quant_jax), torch_view(q_scales_jax)
+
+
+class VllmDeepseekV41IndexerCache(DeepseekV4IndexerCache):
+    """TPU-compatible indexer KV cache.
+
+    The record layout is the V4 one, because the TPU top-k kernel that reads it
+    did not change. Only the compress ratios that select the page size did.
+    """
+
+    def get_kv_cache_spec(self, vllm_config):
+        return MLAAttentionSpec(
+            block_size=self.cache_config.block_size,
+            num_kv_heads=1,
+            head_size=align_to(128 + 1, 128),
+            dtype=torch.uint8,
+            tokens_per_state=self.compress_ratio,
+            alignment=None,
+        )
+
+
+class VllmDeepseekV41Indexer(DeepseekV4Indexer):
+    """TPU-compatible DeepSeek-V4.1 Lightning Indexer with StreamIndex.
+
+    ``forward`` returns the top-k indices rather than upstream's
+    ``(q, q_scale, weights)`` triple. Upstream splits those three values out so
+    a later ``indexer_op`` call can run them on another CUDA stream. TPU has no
+    stream to gain from that split, and the TPU attention layer calls this
+    method directly, so the whole indexer runs in one call. The V4 TPU indexer
+    makes the same deviation.
+    """
+
+    def __init__(self, *args, **kwargs):
+        # The base ctor builds ``self.k_cache`` from the vLLM upstream class.
+        # Temporarily rebind the module-level symbol the base ctor references
+        # so it constructs the TPU subclass directly. V4.1 takes the cache as
+        # an argument as well, so a caller that passes one must pass the TPU
+        # subclass itself.
+        orig_cache = dsv41_attention.DeepseekV4IndexerCache
+        dsv41_attention.DeepseekV4IndexerCache = VllmDeepseekV41IndexerCache
+        try:
+            super().__init__(*args, **kwargs)
+        finally:
+            dsv41_attention.DeepseekV4IndexerCache = orig_cache
+
+    def produce_k(
+        self,
+        latent: torch.Tensor | None,
+        positions: torch.Tensor,
+        rotary_emb: nn.Module,
+    ) -> None:
+        """Turn the compressor's pre-RoPE latent into paged index keys.
+
+        ``k_norm(wk(latent))`` at group-boundary tokens, rotated at the group's
+        first-token position and quantized into the indexer K cache. Rows that
+        do not close a group hold values that this method does not write.
+        """
+        attn_metadata = get_forward_context().attn_metadata
+        if not isinstance(attn_metadata, dict) or latent is None:
+            # Profile run: the indexer K cache is not bound yet.
+            return
+        assert self.owns_k
+
+        # ReplicatedLinear returns (output, bias); bias is None.
+        k_pre, _ = self.wk(latent)
+
+        wrapper_ctx = get_vllm_model_wrapper_context()
+        mesh = wrapper_ctx.mesh
+        cache_index = wrapper_ctx.layer_name_to_kvcache_index[
+            self.k_cache.prefix]
+        cache = wrapper_ctx.kv_caches[cache_index]
+        indexer_metadata = attn_metadata[self.k_cache.prefix]
+
+        ratio = self.compress_ratio
+        eps = self.k_norm.variance_epsilon
+        data_spec = P(ShardingAxisName.ATTN_DATA)
+        cache_spec = P(ShardingAxisName.BATCH)
+
+        def _store(k_pre, positions, query_start_loc, block_tables,
+                   cos_sin_cache, weight, cache):
+            num_tokens = k_pre.shape[0]
+            num_requests = query_start_loc.shape[0] - 1
+            positions = positions.astype(jnp.int32)
+            request_ids = _token_request_ids(query_start_loc, num_tokens)
+
+            # The reference rounds through BF16 after the norm and again after
+            # the rotation. Keep both, so the TPU keys match the reference
+            # bit for bit where the hardware allows it.
+            k = _rms_norm(k_pre.astype(jnp.float32), weight, eps)
+            k = k.astype(jnp.bfloat16).astype(jnp.float32)
+            k = _gptj_rope(k, positions // ratio * ratio, cos_sin_cache)
+            k = k.astype(jnp.bfloat16).astype(jnp.float32)
+
+            # One scale for the whole key, which is the record the TPU top-k
+            # kernel unpacks.
+            values, encoded = quantize_e8m0(k, k.shape[-1])
+            head_dim = values.shape[-1]
+            assert cache.shape[-1] == INDEXER_RECORD_BYTES
+            record = jnp.zeros((num_tokens, cache.shape[-1]), jnp.uint8)
+            record = record.at[:, :head_dim].set(values)
+            record = record.at[:, head_dim:head_dim + 1].set(encoded)
+
+            # The cache is uint8 (pages, rows, packing, record_bytes). One
+            # state occupies one record, so flatten every axis above the last.
+            page_size = cache.shape[1] * cache.shape[2]
+            flat = cache.reshape(-1, cache.shape[-1])
+            slots = _paged_slots(block_tables, request_ids, positions // ratio,
+                                 num_requests, page_size)
+            closes_group = (positions + 1) % ratio == 0
+            slots = jnp.where(closes_group, slots, flat.shape[0])
+            flat = jnp.concatenate(
+                [flat, jnp.zeros((1, flat.shape[1]), flat.dtype)], axis=0)
+            flat = flat.at[slots].set(record)
+            return flat[:-1].reshape(cache.shape)
+
+        wrapper_ctx.kv_caches[cache_index] = jax.shard_map(
+            _store,
+            mesh=mesh,
+            in_specs=(data_spec, data_spec, data_spec, data_spec, P(), P(),
+                      cache_spec),
+            out_specs=cache_spec,
+            check_vma=False,
+        )(
+            jax_view(k_pre),
+            jax_view(positions),
+            indexer_metadata.query_start_loc,
+            indexer_metadata.block_tables,
+            jax_view(rotary_emb.cos_sin_cache),
+            jax_view(self.k_norm.weight),
+            cache,
+        )
+
+    def forward(
+        self,
+        qr: torch.Tensor,
+        latent: Optional[torch.Tensor],
+        indexer_weights: torch.Tensor,
+        positions: torch.Tensor,
+        rotary_emb: nn.Module,
+        qr_scale: Optional[torch.Tensor] = None,
+    ):
+        assert qr_scale is None, "the TPU path does not fuse the query quant"
+        wrapper_ctx = get_vllm_model_wrapper_context()
+        mesh = wrapper_ctx.mesh
+
+        if self.owns_k:
+            # The key write must land before the top-k reads the cache.
+            self.produce_k(latent, positions, rotary_emb)
+
+        # ReplicatedLinear returns (output, bias); bias is None.
+        q, _ = self.wq_b(qr)
+        q = q.view(-1, self.n_head, self.head_dim)
+        q_quant, q_scales = fused_indexer_q_rope_quant(q, positions,
+                                                       rotary_emb, mesh)
+
+        # Fold the query quantization scales into the weights.
+        weights = (indexer_weights.to(q.dtype) * self.softmax_scale *
+                   (self.n_head**-0.5) * q_scales)
+
+        cache_index = wrapper_ctx.layer_name_to_kvcache_index[
+            self.k_cache.prefix]
+        kv_cache = wrapper_ctx.kv_caches[cache_index]
+        attn_metadata = get_forward_context().attn_metadata[
+            self.k_cache.prefix]
+
+        data_spec = P(ShardingAxisName.ATTN_DATA)
+        cache_spec = P(ShardingAxisName.BATCH)
+
+        def _streamindex_topk(q, indexer_weights, cache_kv, seq_lens,
+                              page_indices, cu_q_lens, distribution):
+            return streamindex_topk(
+                q=q,
+                indexer_weights=indexer_weights,
+                cache_kv=cache_kv,
+                seq_lens=seq_lens,
+                page_indices=page_indices,
+                cu_q_lens=cu_q_lens,
+                distribution=distribution,
+                k=self.topk_tokens,
+                compression_ratio=self.compress_ratio,
+                # TODO(hwanginho): Tune num_kv_pages_per_block,
+                # num_queries_per_block.
+                num_kv_pages_per_block=(3, 2, 2),
+                num_queries_per_block=(1, 128, 128),
+            )
+
+        return jax.shard_map(
+            _streamindex_topk,
+            mesh=mesh,
+            in_specs=(data_spec, data_spec, cache_spec, data_spec, data_spec,
+                      data_spec, data_spec),
+            out_specs=data_spec,
+            check_vma=False,
+        )(
+            jax_view(q_quant),
+            jax_view(weights),
+            kv_cache,
+            attn_metadata.seq_lens,
+            attn_metadata.block_tables,
+            attn_metadata.query_start_loc,
+            attn_metadata.request_distribution,
+        )
