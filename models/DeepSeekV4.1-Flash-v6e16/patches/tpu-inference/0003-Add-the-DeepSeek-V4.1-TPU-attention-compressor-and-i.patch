+"""TPU custom ops for DeepSeek V4.1 attention.
+
+V4.1 keeps the class names of V4 but changes the compressor contract, so this
+package is a sibling of ``deepseek_v4`` rather than a set of flags on it. See
+the module docstrings for the delta against each V4 file.
+"""
diff --git a/tpu_inference/layers/vllm/custom_ops/experimental/deepseek_v41/deepseek_v41_attention.py b/tpu_inference/layers/vllm/custom_ops/experimental/deepseek_v41/deepseek_v41_attention.py
new file mode 100644
index 00000000..21fbcc1e
--- /dev/null
+++ b/tpu_inference/layers/vllm/custom_ops/experimental/deepseek_v41/deepseek_v41_attention.py
@@ -0,0 +1,611 @@
+# pytype: skip-file
+# Copyright 2026 Google LLC
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#      http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+"""TPU interception for DeepSeek-V4.1 MLA attention (torchax path).
+
+``DeepseekV4Attention`` is an abstract ``nn.Module`` that the model builds
+directly, not a ``CustomOp``, so there is no registry hook to swap it. Its
+constructor is also CUDA-bound. The TPU port therefore substitutes the class
+symbol before the model is built, as the V4 port does.
+
+The abstract contract did not change between V4 and V4.1: the same three
+methods, with the same signatures. The layer topology did change, and this file
+carries the deltas that follow.
+
+1. A layer owns a compressed KV cache when ``is_kv_source`` is true, not when
+   its compress ratio has a particular value. V4.1-Flash uses ratios 0, 1 and
+   2, so every ``compress_ratio == 4`` test that the V4 file relies on is false
+   for every layer. A copy of the V4 file takes the dense path everywhere and
+   reports no error.
+2. A layer runs an indexer only when ``is_index_source`` is true. Every other
+   compressed layer reads the top-k indices that the nearest index source below
+   it published. This file publishes them on the source module, because the
+   shared ``topk_indices_buffer`` of the CUDA path is an in-place torch buffer
+   that the functional JAX path cannot write.
+3. The compressor consumes the ``fused_wkv_wgate`` projection of the hidden
+   states, not the hidden states. The projection therefore runs in this layer.
+4. The indexer derives its keys from the compressor latent, so there is no
+   indexer K projection over the hidden states.
+5. There is no auxiliary stream. TPU has no CUDA stream object, and the XLA
+   compiler schedules the independent projections itself.
+"""
+import functools
+from unittest.mock import patch
+
+import jax
+import torch
+from jax.sharding import PartitionSpec as P
+from torchax.interop import jax_view, torch_view
+from vllm.config import VllmConfig
+from vllm.forward_context import get_forward_context
+from vllm.models.deepseek_v4_1 import attention as dsv41_attention
+from vllm.models.deepseek_v4_1.attention import (DeepseekV4Attention,
+                                                 _replace_layer_index)
+from vllm.platforms import current_platform
+from vllm.v1.attention.backends.mla.sparse_swa import DeepseekV4SWACache
+from vllm.v1.kv_cache_interface import (KVCacheSpec, MLAAttentionSpec,
+                                        SlidingWindowMLASpec)
+
+from tpu_inference.kernels.experimental.deepseek_v4 import rope as rope_kernel
+from tpu_inference.kernels.experimental.deepseek_v4.core_attention.mla_swa import \
+    mla_sliding_window_ragged_paged_attention
+from tpu_inference.kernels.experimental.deepseek_v4.core_attention.sparse_mla import \
+    sparse_ragged_paged_attention
+from tpu_inference.kernels.experimental.deepseek_v4.o_projection import \
+    fused_reverse_rope_wo_a_projection
+from tpu_inference.layers.common.sharding import ShardingAxisName
+from tpu_inference.layers.vllm.custom_ops.experimental.deepseek_v41.deepseek_v41_compressor import \
+    VllmDeepseekV41Compressor
+from tpu_inference.layers.vllm.custom_ops.experimental.deepseek_v41.deepseek_v41_indexer import (
+    VllmDeepseekV41Indexer, VllmDeepseekV41IndexerCache)
+from tpu_inference.logger import init_logger
+from tpu_inference.models.vllm.vllm_model_wrapper_context import \
+    get_vllm_model_wrapper_context
+
+logger = init_logger(__name__)
+
+# The largest compress ratio a V4.1 layer uses. The SWA cache overlays the
+# compressed NoPE array of a KV-source layer, whose page holds
+# ``cache_config.block_size // compress_ratio`` records of 512 bytes. A ratio
+# of 2 gives the smallest such page, so it bounds the SWA page for every host.
+_MAX_COMPRESS_RATIO = 2
+
+
+def cdiv(a, b):
+    assert b != 0
+    return (a + b - 1) // b
+
+
+def align_to(x, a):
+    return cdiv(x, a) * a
+
+
+def _largest_divisor(x: int, cap: int) -> int:
+    """The largest divisor of ``x`` that is not greater than ``cap``."""
+    for candidate in range(min(x, cap), 0, -1):
+        if x % candidate == 0:
+            return candidate
+    return 1
+
+
+def sharded_rope(rope_fn, mesh, x, positions, cos_sin_cache, **kwargs):
+    data_spec = P(ShardingAxisName.ATTN_DATA)
+
+    def _rope(x, positions, cos_sin_cache):
+        return rope_fn(x, positions, cos_sin_cache, **kwargs)
+
+    return jax.shard_map(
+        _rope,
+        mesh=mesh,
+        in_specs=(data_spec, data_spec, P()),
+        out_specs=data_spec,
+        check_vma=False,
+    )(x, positions, cos_sin_cache)
+
+
+class VllmDeepseekV41SWACache(DeepseekV4SWACache):
+    """TPU-compatible sliding-window cache.
+
+    Every V4.1 layer owns one, including the ratio-0 layers that have nothing
+    else.
+    """
+
+    def __init__(self, *args, **kwargs):
+        # Forward the ctor arguments unchanged. V4.1 passes ``backend_cls`` and
+        # ``block_size``; a pass-through keeps this subclass working when
+        # upstream adds another one.
+        super().__init__(*args, **kwargs)
+        cache_config = self.cache_config
+        # The SWA cache overlays the compressed NoPE array of a KV-source
+        # layer. That array holds ``block_size // compress_ratio`` records of
+        # 512 bytes in one page. An SWA entry is a raw bf16 latent of 512
+        # values, which is 1024 bytes, so a page holds
+        # ``block_size // compress_ratio // 2`` of them. Raw bf16 avoids the
+        # cost of quantization and dequantization inside the sliding window,
+        # and the window is short enough that the extra bytes are small.
+        self.block_size = min(
+            cache_config.block_size // _MAX_COMPRESS_RATIO // 2,
+            self.window_size)
+
+    def get_kv_cache_spec(self, vllm_config: VllmConfig) -> KVCacheSpec:
+        # ``mla_swa`` keeps the SWA entries as raw bf16, packed as uint8.
+        return SlidingWindowMLASpec(
+            block_size=self.block_size,
+            num_kv_heads=1,
+            head_size=512 * 2,
+            dtype=torch.uint8,
+            sliding_window=self.window_size,
+            cache_dtype_str=self.cache_config.cache_dtype,
+            alignment=None,
+        )
+
+
+class VllmDeepseekV41MLAAttention(DeepseekV4Attention):
+    """TPU-compatible DeepSeek-V4.1 MLA attention."""
+
+    # The TPU SWA cache stores raw bf16 rows, not the UE8M0 block-scaled fp8 of
+    # the CUDA backends. Declaring the plain-row layout keeps the base ctor
+    # from rewriting ``cache_config.cache_dtype`` to ``fp8_ds_mla``, which
+    # would make the runner budget a 576-byte token slot that no TPU kernel
+    # reads.
+    use_fp8_ds_mla_layout = False
+
+    # Abstract platform hooks required to instantiate the DeepseekV4Attention
+    # ABC; unused on the TPU pass-through path.
+    from vllm.models.deepseek_v4_1.sparse_mla import DeepseekV4SparseMLABackend
+
+    class _TPUDeepseekV41Backend(DeepseekV4SparseMLABackend):
+
+        @staticmethod
+        def get_name() -> str:
+            return "TPU_MLA"
+
+    backend_cls = _TPUDeepseekV41Backend
+
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        prefix: str = "",
+        topk_indices_buffer: torch.Tensor | None = None,
+        aux_stream_list: list | None = None,
+        candidate_block_buffer: torch.Tensor | None = None,
+    ) -> None:
+        # The base ctor builds the indexer, its cache, the compressor and the
+        # SWA cache from the vLLM upstream classes. Temporarily rebind the
+        # module-level symbols the base ctor references so it constructs the
+        # TPU subclasses directly.
+        originals = {
+            name: getattr(dsv41_attention, name)
+            for name in ("DeepseekV4Indexer", "DeepseekV4IndexerCache",
+                         "DeepseekCompressor", "DeepseekV4SWACache")
+        }
+        dsv41_attention.DeepseekV4Indexer = VllmDeepseekV41Indexer
+        dsv41_attention.DeepseekV4IndexerCache = VllmDeepseekV41IndexerCache
+        dsv41_attention.DeepseekCompressor = VllmDeepseekV41Compressor
+        dsv41_attention.DeepseekV4SWACache = VllmDeepseekV41SWACache
+
+        # The base ctor also allocates CUDA-backed stream-sync events (the
+        # ``ln_events``), used only for GPU stream overlap. Neutralize both
+        # symbols: a real ``torch.cuda.Event`` is a dummy stub on TPU.
+        orig_event = torch.Event
+        orig_cuda_event = torch.cuda.Event
+        torch.Event = lambda *args, **kwargs: None
+        torch.cuda.Event = lambda *args, **kwargs: None
+        try:
+            # The base ctor allocates buffers on the platform device type.
+            # Pass ``cpu`` to keep those allocations off the accelerator; the
+            # forward below never reads them.
+            with patch.object(current_platform, "device_type", "cpu"):
+                super().__init__(
+                    vllm_config,
+                    prefix=prefix,
+                    topk_indices_buffer=topk_indices_buffer,
+                    aux_stream_list=None,
+                    # The candidate-block path narrows the indexer search with
+                    # blocks that layer ``candidate_source_layer_id`` picks.
+                    # The TPU indexer searches the whole cache instead, so it
+                    # needs no candidate buffer. That search is wider, not
+                    # narrower, so recall does not drop.
+                    candidate_block_buffer=None,
+                )
+        finally:
+            for name, value in originals.items():
+                setattr(dsv41_attention, name, value)
+            torch.Event = orig_event
+            torch.cuda.Event = orig_cuda_event
+
+        # Prefix of the layer whose indexer publishes this layer's top-k
+        # indices (itself for an index source).
+        self.index_source_prefix: str | None = None
+        if self.index_source_layer_id is not None:
+            self.index_source_prefix = _replace_layer_index(
+                prefix, self.index_source_layer_id)
+        # ``attention_impl`` sets this on an index source. Consumer layers read
+        # it later in the same forward pass.
+        self._published_topk_indices = None
+
+    @classmethod
+    def get_padded_num_q_heads(cls, num_heads: int) -> int:
+        return num_heads
+
+    def get_kv_cache_spec(self, vllm_config: VllmConfig) -> KVCacheSpec | None:
+        """Only a KV-source layer owns a compressed cache.
+
+        V4 keyed this on the compress ratio, because a ratio of 4 meant the
+        layer was the compressed-sparse-attention source. V4.1 states the role
+        directly, and its ratios never take that value, so the ratio test must
+        not survive the port. A consumer reads the source cache through the
+        forward context, and a ratio-0 layer is pure sliding window.
+        """
+        if not self.is_kv_source:
+            return None
+
+        # ``sparse_mla`` reads the NoPE record from this array and the rotary
+        # channels from the companion ``{prefix}_rope`` array; the budget here
+        # covers both. In the DSv4 fp8 format that is 448 fp8 values, 7 e8m0
+        # scales for those values at block size 64, and 64 bf16 rotary
+        # channels, all packed as uint8.
+        return MLAAttentionSpec(
+            block_size=vllm_config.cache_config.block_size,
+            num_kv_heads=1,
+            head_size=align_to(448 + 7 + 64 * 2, 128),
+            dtype=torch.uint8,
+            tokens_per_state=self.compress_ratio,
+            alignment=None,
+        )
+
+    def _o_proj(self, o: torch.Tensor,
+                positions: torch.Tensor) -> torch.Tensor:
+        """Inverse-RoPE + wo_a (per-group bmm) + wo_b output projection."""
+        mesh = get_vllm_model_wrapper_context().mesh
+        # fused_reverse_rope_wo_a_projection assumes data parallelism for the
+        # attention layer.
+        z = jax.shard_map(
+            functools.partial(
+                fused_reverse_rope_wo_a_projection,
+                head_dim=self.head_dim,
+                inverse=True,
+                quantize_activations=True,
+            ),
+            mesh=mesh,
+            in_specs=(
+                P(ShardingAxisName.ATTN_DATA),  # o
+                P(ShardingAxisName.ATTN_DATA),  # positions
+                P(),  # cos_sin_cache (replicated)
+                P(),  # wo_a
+                P(),  # wo_a_scale
+            ),
+            out_specs=P(ShardingAxisName.ATTN_DATA),
+            check_vma=False,
+        )(
+            jax_view(o),
+            jax_view(positions),
+            jax_view(self.rotary_emb.cos_sin_cache),
+            jax_view(self.wo_a.weight),
+            jax_view(self.wo_a.weight_scale),
+        )
+
+        # wo_b projects back to hidden_size.
+        out = self.wo_b(torch_view(z))
+        if isinstance(out, tuple):
+            out = out[0]
+        return out
+
+    def attn_gemm(self, hidden_states: torch.Tensor):
+        """The input projections, in program order.
+
+        The CUDA layer runs the two light projections on auxiliary streams
+        while the heavy fused projection runs on the default stream. TPU has no
+        stream object, so they run in order and the XLA compiler schedules
+        them.
+        """
+        # MergedColumnParallelLinear returns (output, bias); bias is None.
+        qr_kv, _ = self.fused_wqa_wkv(hidden_states)
+
+        # V4 fused this projection into the TPU compress-and-store kernel and
+        # gave the compressor the hidden states. V4.1 pools two rows of the
+        # projection with a softmax gate over its own trailing channels, so the
+        # projection has to exist as a tensor before the compressor runs.
+        kv_score = None
+        if self.compressor is not None:
+            weight = self.compressor.fused_wkv_wgate.weight
+            # The compressor pools and normalizes in float32. Its epsilon is
+            # 1e-20, which underflows in bf16.
+            kv_score = torch.matmul(hidden_states.to(torch.float32),
+                                    weight.to(torch.float32).t())
+
+        indexer_weights = None
+        if self.indexer is not None:
+            # ReplicatedLinear returns (output, bias); bias is None.
+            indexer_weights, _ = self.indexer.weights_proj(hidden_states)
+
+        return qr_kv, kv_score, indexer_weights
+
+    def qnorm_rope(
+            self,
+            q: torch.Tensor,  # [num_tokens, n_local_heads, head_dim]
+            positions: torch.Tensor,  # [num_tokens], int64
+    ) -> torch.Tensor:
+        """Per-head RMSNorm (no weight) + GPT-J interleaved RoPE on q."""
+        mesh = get_vllm_model_wrapper_context().mesh
+        return torch_view(
+            sharded_rope(
+                rope_kernel.qnorm_rope,
+                mesh,
+                jax_view(q),
+                jax_view(positions),
+                jax_view(self.rotary_emb.cos_sin_cache),
+                eps=self.eps,
+            ))
+
+    def kv_rope(
+            self,
+            kv: torch.Tensor,  # [num_tokens, head_dim]
+            positions: torch.Tensor,  # [num_tokens], int64
+    ) -> torch.Tensor:
+        mesh = get_vllm_model_wrapper_context().mesh
+        return torch_view(
+            sharded_rope(
+                rope_kernel.rope,
+                mesh,
+                jax_view(kv),
+                jax_view(positions),
+                jax_view(self.rotary_emb.cos_sin_cache),
+            ))
+
+    def _topk_indices(self, qr, latent, indexer_weights, positions):
+        """The top-k indices this layer attends over.
+
+        An index source runs its indexer and publishes the result. Every other
+        compressed layer reads what the nearest index source below it
+        published. The layers run in order in one forward pass, so the source
+        always runs first.
+        """
+        if self.indexer is not None:
+            indices = self.indexer(qr, latent, indexer_weights, positions,
+                                   self.indexer_rotary_emb)
+            self._published_topk_indices = indices
+            return indices
+
+        if self.compress_ratio == 0:
+            return None
+
+        assert self.index_source_prefix is not None
+        source = self._static_forward_context[self.index_source_prefix]
+        indices = source._published_topk_indices
+        assert indices is not None, (
+            f"index source {self.index_source_prefix} published no top-k "
+            f"indices before layer {self.layer_id} read them")
+        return indices
+
+    def attention_impl(
+            self,
+            qr: torch.Tensor,
+            kv: torch.Tensor,
+            kv_score: torch.Tensor | None,
+            indexer_weights: torch.Tensor | None,
+            positions: torch.Tensor,
+    ) -> torch.Tensor:
+        """Query preparation, compression, indexing, then sparse attention.
+
+        The order matters. The compressor latent feeds the indexer keys, and
+        both cache writes must land before the sparse attention reads either
+        cache.
+        """
+        q = self.wq_b(qr).view(-1, self.n_local_heads, self.head_dim)
+        q = self.qnorm_rope(q, positions)
+        kv = self.kv_rope(kv, positions)
+
+        latent = None
+        if self.compressor is not None:
+            latent = self.compressor(kv_score, positions)
+
+        topk_indices = self._topk_indices(qr, latent, indexer_weights,
+                                          positions)
+
+        if self.compressor is not None:
+            self.compressor.insert_cache(latent, positions, self.rotary_emb)
+
+        return self.forward_mqa(q,
+                                kv,
+                                positions,
+                                None,
+                                topk_indices=topk_indices)
+
+    def forward_mqa(
+        self,
+        q: torch.Tensor,
+        kv: torch.Tensor,
+        positions: torch.Tensor,
+        output: torch.Tensor,  # Not used
+        *,
+        topk_indices: torch.Tensor | None,
+    ) -> torch.Tensor:
+        """The SWA cache update, then attention over SWA and compressed KV.
+
+        A ratio-0 layer has no compressed cache and stops after the sliding
+        window. Every other layer continues into the sparse kernel with the
+        top-k indices its index source published.
+        """
+        swa_only = self.compress_ratio == 0
+
+        wrapper_ctx = get_vllm_model_wrapper_context()
+        mesh = wrapper_ctx.mesh
+        attn_metadata = get_forward_context().attn_metadata
+        assert isinstance(attn_metadata, dict)
+
+        # --- SWA layer cache + metadata (always present)
+        swa_layer_name = self.swa_cache_layer.prefix
+        swa_attn_metadata = attn_metadata[swa_layer_name]
+        swa_cache_index = wrapper_ctx.layer_name_to_kvcache_index[
+            swa_layer_name]
+        sw_cache = wrapper_ctx.kv_caches[swa_cache_index]
+        attention_sinks = jax_view(self.attn_sink)
+
+        two_caches_same_buffer = False
+        if swa_only:
+            # The main cache operands are placeholders that the kernel below
+            # never reads on this path.
+            main_cache_nope = sw_cache
+            main_cache_rope = sw_cache
+            main_topk = swa_attn_metadata.seq_lens
+            main_page_indices = swa_attn_metadata.block_tables
+            main_cu_q_lens = swa_attn_metadata.query_start_loc
+            main_distribution = swa_attn_metadata.request_distribution
+        else:
+            assert topk_indices is not None
+            # A KV-source layer reads its own cache; a consumer reads the cache
+            # of the nearest KV source below it.
+            main_layer_name = self.compressed_cache_prefix
+            assert main_layer_name is not None
+            main_attn_metadata = attn_metadata[main_layer_name]
+            nope_index = wrapper_ctx.layer_name_to_kvcache_index[
+                main_layer_name]
+            rope_index = wrapper_ctx.layer_name_to_kvcache_index[
+                f"{main_layer_name}_rope"]
+            main_cache_nope = wrapper_ctx.kv_caches[nope_index]
+            main_cache_rope = wrapper_ctx.kv_caches[rope_index]
+            main_topk = jax_view(topk_indices)
+            main_page_indices = main_attn_metadata.block_tables
+            main_cu_q_lens = main_attn_metadata.query_start_loc
+            main_distribution = main_attn_metadata.request_distribution
+            # The SWA cache overlays a NoPE array. When it overlays the NoPE
+            # array this layer reads, the sparse kernel must see the copy the
+            # sliding-window kernel just wrote.
+            two_caches_same_buffer = (nope_index == swa_cache_index)
+
+        # All array inputs and outputs are sharded along the leading axis on
+        # ShardingAxisName.ATTN_DATA (caches on ShardingAxisName.BATCH);
+        # `attention_sinks` is replicated. The kernels run per-shard.
+        data_spec = P(ShardingAxisName.ATTN_DATA)
+        cache_spec = P(ShardingAxisName.BATCH)
+        in_specs = (
+            data_spec,  # q
+            data_spec,  # new_kv
+            cache_spec,  # sw_cache
+            data_spec,  # swa_kv_lens
+            data_spec,  # swa_page_indices
+            data_spec,  # swa_cu_q_lens
+            data_spec,  # swa_distribution
+            cache_spec,  # main_cache_nope
+            cache_spec,  # main_cache_rope
+            data_spec,  # main_topk
+            data_spec,  # main_page_indices
+            data_spec,  # main_cu_q_lens
+            data_spec,  # main_distribution
+            P(),  # attention_sinks (replicated)
+        )
+        out_specs = (
+            data_spec,  # attention output
+            cache_spec,  # updated swa cache
+        )
+
+        def _attention(q, new_kv, sw_cache, swa_kv_lens, swa_page_indices,
+                       swa_cu_q_lens, swa_distribution, main_cache_nope,
+                       main_cache_rope, main_topk, main_page_indices,
+                       main_cu_q_lens, main_distribution, attention_sinks):
+            swa_output, updated_sw_cache, swa_l, swa_m = (
+                mla_sliding_window_ragged_paged_attention(
+                    q=q,
+                    new_kv=new_kv,
+                    cache_kv=sw_cache,
+                    kv_lens=swa_kv_lens,
+                    page_indices=swa_page_indices,
+                    cu_q_lens=swa_cu_q_lens,
+                    distribution=swa_distribution,
+                    attention_sinks=attention_sinks,
+                    sm_scale=self.scale,
+                    sliding_window=self.window_size,
+                    logical_page_size=self.swa_cache_layer.block_size,
+                    # TODO: tune num_kv_pages_per_block & num_queries_per_block
+                    num_kv_pages_per_block=(2, 2, 2),
+                    num_queries_per_block=(1, 32, 32),
+                    q_compute_block_size=4,
+                    unnormalized_output=False if swa_only else True,
+                ))
+
+            if swa_only:
+                return swa_output, updated_sw_cache
+
+            if two_caches_same_buffer:
+                main_cache_nope = updated_sw_cache
+
+            # The sparse kernel gathers only the top-k KV states per query.
+            chunk_size = 64 if (q.shape[0] % 64 == 0) else None
+            if chunk_size is None:
+                # The kernel falls back to a single chunk of q.shape[0]; the
+                # batch size must divide it.
+                batch_size = _largest_divisor(q.shape[0], 16)
+            else:
+                batch_size = 16
+            output = sparse_ragged_paged_attention(
+                q=q,
+                cache_kv_nope=main_cache_nope,
+                cache_kv_rope=main_cache_rope,
+                topk_indices=main_topk,
+                page_indices=main_page_indices,
+                cu_q_lens=main_cu_q_lens,
+                distribution=main_distribution,
+                attention_sinks=attention_sinks,
+                swa_accumution=swa_output,
+                swa_l=swa_l,
+                swa_m=swa_m,
+                sm_scale=self.scale,
+                # TODO: tune attention_kernel_batch_size &
+                # gather_and_attention_chunk_size.
+                gather_and_attention_chunk_size=chunk_size,
+                attention_kernel_batch_size=batch_size,
+            )
+            return output, updated_sw_cache
+
+        output, updated_sw_cache = jax.shard_map(
+            _attention,
+            mesh=mesh,
+            in_specs=in_specs,
+            out_specs=out_specs,
+            check_vma=False,
+        )(
+            jax_view(q),
+            jax_view(kv),
+            sw_cache,
+            swa_attn_metadata.seq_lens,
+            swa_attn_metadata.block_tables,
+            swa_attn_metadata.query_start_loc,
+            swa_attn_metadata.request_distribution,
+            main_cache_nope,
+            main_cache_rope,
+            main_topk,
+            main_page_indices,
+            main_cu_q_lens,
+            main_distribution,
+            attention_sinks,
+        )
+
+        wrapper_ctx.kv_caches[swa_cache_index] = updated_sw_cache
+        return torch_view(output)
+
+    def forward(
+        self,
+        positions: torch.Tensor,
+        hidden_states: torch.Tensor,
+        llama_4_scaling: torch.Tensor | None = None,
+    ) -> torch.Tensor:
+        qr_kv, kv_score, indexer_weights = self.attn_gemm(hidden_states)
+        qr, kv = qr_kv.split([self.q_lora_rank, self.head_dim], dim=-1)
+        qr = self.q_norm(qr)
+        kv = self.kv_norm(kv)
+
+        attn_output = self.attention_impl(qr, kv, kv_score, indexer_weights,
+                                          positions)
+        return self._o_proj(attn_output, positions)
