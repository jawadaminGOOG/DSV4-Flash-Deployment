+def _real_tokens(query_start_loc: jax.Array, request_ids: jax.Array,
+                 num_tokens: int) -> jax.Array:
+    """Which packed rows hold a token of a real request.
+
+    The runner pads the token axis up to a compiled bucket. A padding row
+    inherits the last request's id, and its position is whatever the padding
+    buffer holds. Every scatter in this module must mask on this array, or a
+    padding row overwrites a live cache slot. The CUDA kernels get the same
+    protection from a ``slot_mapping`` of -1, which the TPU metadata does not
+    carry.
+    """
+    tokens = jnp.arange(num_tokens, dtype=jnp.int32)
+    return tokens < query_start_loc[request_ids + 1]
+
+
 def _rms_norm(x: jax.Array, weight: jax.Array, eps: float) -> jax.Array:
     """RMSNorm over the last axis, accumulated in float32.
 
@@ -146,6 +161,107 @@ def _paged_slots(block_tables: jax.Array, request_ids: jax.Array,
     return blocks[request_ids, page] * page_size + row_indices % page_size
 
 
+def pool_ratio_two(
+    kv_score: jax.Array,
+    positions: jax.Array,
+    query_start_loc: jax.Array,
+    block_tables: jax.Array,
+    ring: jax.Array,
+    weight: jax.Array,
+    head_dim: int,
+    eps: float,
+) -> tuple[jax.Array, jax.Array]:
+    """Pool each closed pair of rows with the gate, then refill the ring.
+
+    A group is the token pair that ends at an odd position. The first token of
+    a chunk pools against a row the previous chunk left in the ring, so the
+    ring is read before it is written. JAX makes that ordering explicit: the
+    gather reads the array this call received and the scatter produces a new
+    one.
+
+    This is a pure function of its arguments so a test can drive it with
+    handmade metadata. The layer calls it inside a ``shard_map``.
+
+    Returns the BF16 latent of every row, and the new ring. A row that does not
+    close a group holds a value that no consumer reads.
+    """
+    num_tokens = kv_score.shape[0]
+    num_requests = query_start_loc.shape[0] - 1
+    capacity = ring.shape[1]
+    tokens = jnp.arange(num_tokens, dtype=jnp.int32)
+    request_ids = _token_request_ids(query_start_loc, num_tokens)
+    positions = positions.astype(jnp.int32)
+    kv_score = kv_score.astype(jnp.float32)
+
+    # The ring row of the token before this one, in this token's own request.
+    # Only a chunk's first token reads it.
+    ring_slots = _paged_slots(block_tables, request_ids,
+                              (positions - 1) % capacity, num_requests,
+                              capacity)
+    previous_ring = ring.reshape(-1, ring.shape[-1])[ring_slots]
+
+    # The row before this one inside the chunk. Row 0 has none, and the
+    # chunk-start test below discards it.
+    previous_chunk = jnp.roll(kv_score, 1, axis=0)
+    is_chunk_start = tokens == query_start_loc[request_ids]
+    previous = jnp.where(is_chunk_start[:, None], previous_ring,
+                         previous_chunk)
+
+    pair = jnp.stack([previous, kv_score], axis=0)
+    gate = jax.nn.softmax(pair[:, :, head_dim:], axis=0)
+    pooled = jnp.sum(pair[:, :, :head_dim] * gate, axis=0)
+    latent = _rms_norm(pooled, weight, eps).astype(jnp.bfloat16)
+
+    # Refill the ring with the chunk's last ``capacity`` rows. The bound is not
+    # an optimization. The stored rows hold consecutive positions and number at
+    # most ``capacity``, so their ``positions % capacity`` values are distinct
+    # and each ring slot takes one write. A wider window would send two rows to
+    # one slot, and a scatter with a repeated index has no defined winner.
+    chunk_end = query_start_loc[request_ids + 1]
+    store = (chunk_end - tokens) <= capacity
+    store &= _real_tokens(query_start_loc, request_ids, num_tokens)
+    store_slots = _paged_slots(block_tables, request_ids, positions % capacity,
+                               num_requests, capacity)
+    flat_ring = ring.reshape(-1, ring.shape[-1])
+    # One row past the end absorbs the masked-out writes.
+    store_slots = jnp.where(store, store_slots, flat_ring.shape[0])
+    flat_ring = jnp.concatenate(
+        [flat_ring, jnp.zeros((1, flat_ring.shape[1]), flat_ring.dtype)],
+        axis=0)
+    flat_ring = flat_ring.at[store_slots].set(kv_score.astype(flat_ring.dtype))
+    return latent, flat_ring[:-1].reshape(ring.shape)
+
+
+def build_kv_records(
+    latent: jax.Array,
+    positions: jax.Array,
+    cos_sin_cache: jax.Array,
+    ratio: int,
+    nope_record_bytes: int,
+) -> tuple[jax.Array, jax.Array]:
+    """Rotate a latent and pack it into the NoPE and RoPE cache records.
+
+    A latent stands for its whole group, so it rotates at the position of the
+    group's first token. The NoPE record holds 448 FP8 E4M3 bytes then 7 E8M0
+    scale bytes, zero-padded to the record width. The RoPE record holds the 64
+    rotary channels in BF16.
+
+    This is a pure function of its arguments so a test can compare it against
+    the CUDA kernel without a mesh.
+    """
+    rotated = _gptj_rope(latent.astype(jnp.float32),
+                         positions.astype(jnp.int32) // ratio * ratio,
+                         cos_sin_cache)
+    values, scales = quantize_e8m0(rotated[:, :NOPE_CHANNELS], QUANT_BLOCK)
+    nope_record = jnp.zeros((latent.shape[0], nope_record_bytes), jnp.uint8)
+    nope_record = nope_record.at[:, :NOPE_CHANNELS].set(values)
+    nope_record = nope_record.at[:, NOPE_CHANNELS:NOPE_CHANNELS +
+                                 scales.shape[1]].set(scales)
+    rope_record = rotated[:, NOPE_CHANNELS:].astype(jnp.bfloat16).view(
+        jnp.uint8)
+    return nope_record, rope_record
+
