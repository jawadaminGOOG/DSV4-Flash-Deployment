+"""Numerical tests for the DeepSeek-V4.1 compressor primitives.
+
+Each test compares a JAX primitive against an independent PyTorch reference of
+the CUDA kernel it replaces. The references are written in a different
+formulation from the code under test where that is possible: the rotation uses
+complex multiplication, and the pooling reference iterates one group at a time.
+A transcription that shares the original's structure can share its mistakes.
+
+The tests call the module-level functions the layer itself calls, not copies of
+them, so a change to the layer's arithmetic fails a test here.
+"""
+
+import sys
+import types
+
+import jax
+import jax.numpy as jnp
+import pytest
+import torch
+
+HEAD_DIM = 512
+STATE_DIM = 2 * HEAD_DIM
+EPS = 1e-20
+
+
+def _stub_upstream_base_classes() -> None:
+    """Install placeholders for ``vllm.models.deepseek_v4_1`` when it is absent.
+
+    The compressor module imports two base classes from upstream vLLM at module
+    scope. The functions under test are pure JAX and never reach those classes,
+    but the import must still resolve. A vLLM old enough to predate V4.1 can
+    run these tests with the placeholders.
+    """
+    try:
+        import vllm.models.deepseek_v4_1.compressor  # noqa: F401
+        return
+    except ImportError:
+        pass
+
+    class _Placeholder:
+        pass
+
+    compressor = types.ModuleType("vllm.models.deepseek_v4_1.compressor")
+    compressor.CompressorStateCache = _Placeholder
+    compressor.DeepseekCompressor = _Placeholder
+    package = types.ModuleType("vllm.models.deepseek_v4_1")
+    package.compressor = compressor
+    sys.modules.setdefault("vllm.models", types.ModuleType("vllm.models"))
+    sys.modules["vllm.models.deepseek_v4_1"] = package
+    sys.modules["vllm.models.deepseek_v4_1.compressor"] = compressor
+
+
+_stub_upstream_base_classes()
+
+from tpu_inference.layers.vllm.custom_ops.experimental.deepseek_v41.deepseek_v41_compressor import (  # noqa: E402
+    _gptj_rope, _paged_slots, _rms_norm, build_kv_records, pool_ratio_two,
+    quantize_e8m0)
+
+# Two units of last place in BF16. The pooled value is computed in float32 and
+# rounded once, so the two paths may disagree by a rounding step.
+BF16_TOLERANCE = 2**-7
+
+
+def _assert_bf16_close(actual: jax.Array, expected: torch.Tensor) -> None:
+    got = torch.from_numpy(jax.device_get(actual.astype(jnp.float32)))
+    want = expected.to(torch.bfloat16).to(torch.float32)
+    scale = torch.clamp(want.abs(), min=1e-6)
+    error = ((got - want).abs() / scale).max().item()
+    assert error <= BF16_TOLERANCE, f"relative error {error} over one group"
+
+
+def _reference_pool(rows: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    """One pooled and normalized latent from the rows of a single group.
+
+    This follows ``_fused_save_compress_norm_kernel``: the gate is a softmax
+    over the group of the score half, the pooled value is the gated sum of the
+    kv half, and the RMSNorm runs on the float32 pooled value with no
+    intermediate rounding.
+    """
+    rows = rows.to(torch.float32)
+    gate = torch.softmax(rows[:, HEAD_DIM:], dim=0)
+    pooled = (rows[:, :HEAD_DIM] * gate).sum(0)
+    variance = pooled.pow(2).mean()
+    return pooled * torch.rsqrt(variance + EPS) * weight.to(torch.float32)
+
+
+def _pool_inputs(num_tokens: int, seed: int = 0):
+    generator = torch.Generator().manual_seed(seed)
+    kv_score = torch.randn(num_tokens,
+                           STATE_DIM,
+                           generator=generator,
+                           dtype=torch.float32)
+    weight = torch.rand(HEAD_DIM, generator=generator,
+                        dtype=torch.float32) + 0.5
+    return kv_score, weight
+
+
+def _as_jax(tensor: torch.Tensor) -> jax.Array:
+    return jnp.asarray(tensor.numpy())
+
+
+# A ring page holds ``CAPACITY`` rows. Every request owns exactly one page, so
+# the page index of a ring row is always zero and the slot is the row itself.
+CAPACITY = 4
+NUM_PAGES = 4
+
+
+def _ring_and_tables(page_of_request: list[int]):
+    ring = jnp.zeros((NUM_PAGES, CAPACITY, STATE_DIM), jnp.float32)
+    block_tables = jnp.asarray(page_of_request, jnp.int32)
+    return ring, block_tables
+
+
+def test_pool_ratio_two_matches_reference_in_one_chunk():
+    """Every closing row pools its own pair, and no other pair."""
+    kv_score, weight = _pool_inputs(8)
+    ring, block_tables = _ring_and_tables([1])
+    query_start_loc = jnp.asarray([0, 8], jnp.int32)
+    positions = jnp.arange(8, dtype=jnp.int32)
+
+    latent, _ = pool_ratio_two(_as_jax(kv_score), positions, query_start_loc,
+                               block_tables, ring, _as_jax(weight), HEAD_DIM,
+                               EPS)
+
+    for position in (1, 3, 5, 7):
+        expected = _reference_pool(kv_score[position - 1:position + 1], weight)
+        _assert_bf16_close(latent[position], expected)
+
+
+def test_pool_ratio_two_carries_a_group_across_a_chunk_boundary():
+    """A group split by chunked prefill pools the same pair as an unsplit one.
+
+    The first chunk ends after position 4, so the group {4, 5} straddles the
+    boundary. Row 5 must reach row 4 through the ring.
+    """
+    kv_score, weight = _pool_inputs(8, seed=1)
+    ring, block_tables = _ring_and_tables([1])
+
+    _, ring_after = pool_ratio_two(_as_jax(kv_score[:5]),
+                                   jnp.arange(5, dtype=jnp.int32),
+                                   jnp.asarray([0, 5], jnp.int32),
+                                   block_tables, ring, _as_jax(weight),
+                                   HEAD_DIM, EPS)
+
+    latent, _ = pool_ratio_two(_as_jax(kv_score[5:]),
+                               jnp.arange(5, 8, dtype=jnp.int32),
+                               jnp.asarray([0, 3], jnp.int32), block_tables,
+                               ring_after, _as_jax(weight), HEAD_DIM, EPS)
+
+    # Row 0 of the second chunk is position 5, the row that closes the
+    # straddling group.
+    expected = _reference_pool(kv_score[4:6], weight)
+    _assert_bf16_close(latent[0], expected)
+
+
+def test_pool_ratio_two_keeps_only_the_last_capacity_rows():
+    """The ring holds the chunk's final rows, one row for each position."""
+    kv_score, weight = _pool_inputs(6, seed=2)
+    ring, block_tables = _ring_and_tables([2])
+
+    _, ring_after = pool_ratio_two(_as_jax(kv_score),
+                                   jnp.arange(6, dtype=jnp.int32),
+                                   jnp.asarray([0, 6], jnp.int32),
+                                   block_tables, ring, _as_jax(weight),
+                                   HEAD_DIM, EPS)
+
+    page = torch.from_numpy(jax.device_get(ring_after[2]))
+    for position in range(2, 6):
+        torch.testing.assert_close(page[position % CAPACITY],
+                                   kv_score[position])
+
+
+def test_pool_ratio_two_ignores_padding_rows():
+    """A padded token row must not write the ring.
+
+    The runner pads the token axis to a compiled bucket. A padding row inherits
+    the last request's id, and its position points at a live ring slot. Without
+    the real-token mask the padding overwrites a row the next chunk reads.
+    """
+    kv_score, weight = _pool_inputs(8, seed=3)
+    ring, block_tables = _ring_and_tables([3])
+    positions = jnp.arange(8, dtype=jnp.int32)
+
+    _, unpadded = pool_ratio_two(_as_jax(kv_score[:5]), positions[:5],
+                                 jnp.asarray([0, 5], jnp.int32), block_tables,
+                                 ring, _as_jax(weight), HEAD_DIM, EPS)
+
+    # Three padding rows. Their positions land on ring slots 3, 0 and 1, which
+    # the five real rows already own.
+    padded_positions = jnp.asarray([0, 1, 2, 3, 4, 3, 4, 5], jnp.int32)
+    _, padded = pool_ratio_two(_as_jax(kv_score), padded_positions,
+                               jnp.asarray([0, 5, 5, 5], jnp.int32),
+                               jnp.tile(block_tables, 3), ring,
+                               _as_jax(weight), HEAD_DIM, EPS)
+
+    torch.testing.assert_close(torch.from_numpy(jax.device_get(padded)),
+                               torch.from_numpy(jax.device_get(unpadded)))
+
+
+def test_rms_norm_keeps_a_tiny_epsilon_meaningful():
+    """V4.1-Flash sets ``rms_norm_eps`` to 1e-20, which needs float32."""
+    generator = torch.Generator().manual_seed(4)
+    x = torch.randn(3, HEAD_DIM, generator=generator, dtype=torch.float32)
+    weight = torch.rand(HEAD_DIM, generator=generator, dtype=torch.float32)
+
+    got = _rms_norm(_as_jax(x), _as_jax(weight), EPS)
+    want = x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + EPS) * weight
+
+    torch.testing.assert_close(torch.from_numpy(jax.device_get(got)),
+                               want,
+                               rtol=1e-6,
+                               atol=1e-6)
+
+
+def test_gptj_rope_matches_a_complex_rotation():
+    """The interleaved rotation is a complex multiply on each channel pair."""
+    generator = torch.Generator().manual_seed(5)
+    x = torch.randn(4, HEAD_DIM, generator=generator, dtype=torch.float32)
+    angles = torch.rand(16, 32, generator=generator, dtype=torch.float32) * 6.0
+    cos_sin = torch.cat([angles.cos(), angles.sin()], dim=-1)
+    positions = torch.tensor([0, 3, 7, 15], dtype=torch.int32)
+
+    got = _gptj_rope(_as_jax(x), _as_jax(positions), _as_jax(cos_sin))
+
+    tail = torch.view_as_complex(x[:, -64:].reshape(4, 32, 2).contiguous())
+    rotor = torch.polar(torch.ones(4, 32), angles[positions.long()])
+    want = torch.cat(
+        [x[:, :-64],
+         torch.view_as_real(tail * rotor).reshape(4, 64)], dim=-1)
+
+    torch.testing.assert_close(torch.from_numpy(jax.device_get(got)),
+                               want,
+                               rtol=1e-5,
+                               atol=1e-5)
+
+
+def test_quantize_e8m0_round_trips_within_fp8_precision():
+    """A reader recovers the value with ``value * 2 ** (scale - 127)``."""
+    generator = torch.Generator().manual_seed(6)
+    x = torch.randn(2, 448, generator=generator, dtype=torch.float32) * 30.0
+
+    values, scales = quantize_e8m0(_as_jax(x), 64)
+    decoded = jnp.asarray(values).view(jnp.float8_e4m3fn).astype(jnp.float32)
+    factor = jnp.exp2(scales.astype(jnp.float32) - 127.0)
+    restored = decoded.reshape(2, 7, 64) * factor[:, :, None]
+
+    error = (torch.from_numpy(jax.device_get(restored)).reshape(2, 448) -
+             x).abs() / x.abs().clamp(min=1e-6)
+    assert error.max().item() <= 0.07, "FP8 E4M3 holds three mantissa bits"
+
+
+def test_build_kv_records_rotates_at_the_group_position():
+    """Both rows of a group rotate at the position of the group's first row."""
+    generator = torch.Generator().manual_seed(7)
+    latent = torch.randn(1, HEAD_DIM, generator=generator,
+                         dtype=torch.float32).repeat(4, 1)
+    angles = torch.rand(16, 32, generator=generator, dtype=torch.float32) * 6.0
+    cos_sin = torch.cat([angles.cos(), angles.sin()], dim=-1)
+    # One latent at four positions. Rows 0 and 1 form group 2 and must produce
+    # the same record. Row 2 opens group 3 and must not.
+    positions = jnp.asarray([4, 5, 6, 7], jnp.int32)
+
+    nope, rope = build_kv_records(_as_jax(latent), positions,
+                                  _as_jax(cos_sin), 2, 512)
+
+    assert nope.shape == (4, 512) and rope.shape == (4, 128)
+    torch.testing.assert_close(torch.from_numpy(jax.device_get(nope[0])),
+                               torch.from_numpy(jax.device_get(nope[1])))
+    torch.testing.assert_close(torch.from_numpy(jax.device_get(rope[0])),
+                               torch.from_numpy(jax.device_get(rope[1])))
+    assert not jnp.array_equal(rope[0], rope[2]), "group 3 rotates differently"
+    # The record is 448 quantized bytes, then 7 scale bytes, then zero padding.
+    assert bool(jnp.all(nope[:, 455:] == 0))
+
+
+@pytest.mark.parametrize("row,expected", [(0, 40), (3, 43), (8, 72), (11, 75)])
+def test_paged_slots_walks_the_block_table(row: int, expected: int):
+    """A row maps to ``block * page_size + offset`` through the block table."""
+    block_tables = jnp.asarray([5, 9, 0, 0], jnp.int32)
+    got = _paged_slots(block_tables, jnp.asarray([0], jnp.int32),
+                       jnp.asarray([row], jnp.int32), 2, 8)
+    assert int(got[0]) == expected
