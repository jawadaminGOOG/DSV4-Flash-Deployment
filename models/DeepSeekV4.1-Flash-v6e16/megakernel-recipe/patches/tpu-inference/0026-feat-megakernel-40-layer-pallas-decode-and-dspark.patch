+        pltpu.VMEM((batch_tile, 128), jnp.float32),   # sink_vmem
+        pltpu.VMEM((4096, 512), jnp.float8_e4m3fn),   # woa_vmem
+        pltpu.VMEM((128, 512), jnp.uint8),            # woa_s_vmem
+        pltpu.VMEM((512, 5120), jnp.float8_e4m3fn),   # wob_vmem
