+    hc_attn_mb: jax.Array       # P(): [40, B_tile, 128] f32
+    hc_ffn_fn: jax.Array        # P(): [40, 5120, 128] f32
+    hc_ffn_mb: jax.Array        # P(): [40, B_tile, 128] f32
+
