+    wkv_s: jax.Array            # P(): [40, 160, 512] u8
+    kvn: jax.Array              # P(): [40, B_tile, 512] bf16
+
+    wqb: jax.Array              # P("tp"): per-chip [40, 1280, 4096] f8
+    wqb_s: jax.Array            # P("tp"): per-chip [40, 40, 4096] u8
