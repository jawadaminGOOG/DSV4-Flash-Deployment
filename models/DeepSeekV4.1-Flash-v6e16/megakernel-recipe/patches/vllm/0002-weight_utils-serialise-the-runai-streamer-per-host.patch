+@contextmanager
+def _runai_host_lock(hold: bool) -> Generator[None, None, None]:
+    """Hold an exclusive lock that every rank on this host shares.
+
+    `flock` is a kernel object, so the lock covers one node and nothing wider.
+    That is the scope that matters, because host memory is what runs out.
+    """
+    if not hold:
+        yield
+        return
+    with open(RUNAI_HOST_LOCK_PATH, "a") as lock_file:
+        fcntl.flock(lock_file, fcntl.LOCK_EX)
+        try:
+            yield
+        finally:
+            fcntl.flock(lock_file, fcntl.LOCK_UN)
